<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SimpleGit11.Setup.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="32" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image Source="Assets/MainLogo.png" Width="56" Height="56" Stretch="Uniform"
                   AutomationProperties.AccessibilityView="Raw" />
            <TextBlock x:Name="PageTitle" Grid.Column="1" Style="{StaticResource TitleTextBlockStyle}"
                       VerticalAlignment="Center" TextWrapping="Wrap" />
            <ComboBox x:Name="LanguageSelector" Grid.Column="2" Width="140" VerticalAlignment="Center" SelectionChanged="LanguageSelector_SelectionChanged"
                      AutomationProperties.AutomationId="SetupLanguage">
                <ComboBoxItem />
                <ComboBoxItem />
            </ComboBox>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="20">
                <StackPanel x:Name="DetectingPanel" Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressRing IsActive="True" Width="48" Height="48" HorizontalAlignment="Center" />
                    <TextBlock x:Name="DetectingText" HorizontalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel x:Name="WelcomePanel" Spacing="16" Visibility="Collapsed">
                    <TextBlock x:Name="WelcomeText" TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}" />
                    <TextBlock x:Name="WelcomeNote" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel x:Name="ScopePanel" Spacing="16" Visibility="Collapsed">
                    <TextBlock x:Name="ScopeText" TextWrapping="Wrap" />
                    <RadioButton x:Name="UserScope" GroupName="InstallScope" IsChecked="True"
                                 AutomationProperties.AutomationId="SetupUserScope" />
                    <RadioButton x:Name="MachineScope" GroupName="InstallScope"
                                 AutomationProperties.AutomationId="SetupMachineScope" />
                    <TextBlock x:Name="MachineScopeNote" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel x:Name="FolderPanel" Spacing="12" Visibility="Collapsed">
                    <TextBlock x:Name="FolderText" TextWrapping="Wrap" />
                    <TextBox x:Name="FolderPath" Header="" AutomationProperties.AutomationId="SetupFolder" />
                    <Button x:Name="BrowseButton" Click="BrowseButton_Click" HorizontalAlignment="Left"
                            AutomationProperties.AutomationId="SetupBrowse" />
                    <TextBlock x:Name="FolderValidation" TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>

                <StackPanel x:Name="FeaturesPanel" Spacing="16" Visibility="Collapsed">
                    <TextBlock x:Name="FeaturesText" TextWrapping="Wrap" />
                    <CheckBox x:Name="SshFeature" AutomationProperties.AutomationId="SetupSsh" />
                    <CheckBox x:Name="DesktopFeature" AutomationProperties.AutomationId="SetupDesktop" />
                </StackPanel>

                <StackPanel x:Name="MaintenancePanel" Spacing="16" Visibility="Collapsed">
                    <TextBlock x:Name="MaintenanceText" TextWrapping="Wrap" />
                    <Button x:Name="ChangeButton" Click="ChangeButton_Click" AutomationProperties.AutomationId="SetupChange" />
                    <Button x:Name="RepairButton" Click="RepairButton_Click" AutomationProperties.AutomationId="SetupRepair" />
                    <Button x:Name="RemoveButton" Click="RemoveButton_Click" AutomationProperties.AutomationId="SetupRemove" />
                </StackPanel>

                <StackPanel x:Name="PurgePanel" Spacing="16" Visibility="Collapsed">
                    <TextBlock x:Name="PurgeText" TextWrapping="Wrap" />
                    <CheckBox x:Name="PurgeData" AutomationProperties.AutomationId="SetupPurgeData" />
                    <TextBlock x:Name="PurgeWarning" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel x:Name="ReadyPanel" Spacing="16" Visibility="Collapsed">
                    <TextBlock x:Name="ReadyText" TextWrapping="Wrap" />
                    <TextBlock x:Name="ReadySummary" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel x:Name="ProgressPanel" Spacing="16" Visibility="Collapsed">
                    <TextBlock x:Name="ProgressText" TextWrapping="Wrap" />
                    <ProgressBar x:Name="InstallProgress" Minimum="0" Maximum="100" Height="8" />
                    <TextBlock x:Name="ProgressPercent" />
                </StackPanel>

                <StackPanel x:Name="ResultPanel" Spacing="16" Visibility="Collapsed">
                    <TextBlock x:Name="ResultText" TextWrapping="Wrap" />
                    <TextBlock x:Name="ResultDetails" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="CancelButton" Grid.Column="1" Click="CancelButton_Click"
                    AutomationProperties.AutomationId="SetupCancel" />
            <Button x:Name="BackButton" Grid.Column="2" Click="BackButton_Click" Visibility="Collapsed"
                    AutomationProperties.AutomationId="SetupBack" />
            <Button x:Name="NextButton" Grid.Column="3" Click="NextButton_Click" Visibility="Collapsed"
                    Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="SetupNext" />
        </Grid>
    </Grid>
</Window>
