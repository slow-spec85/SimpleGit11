<Project Sdk="MSTest.Sdk/4.3.2">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.18362.0</TargetPlatformMinVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SimpleGit11.Tests</RootNamespace>
    <AssemblyName>SimpleGit11.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SimpleGit11.Extensibility\SimpleGit11.Extensibility.csproj" />
    <ProjectReference Include="..\SimpleGit11\SimpleGit11.csproj" />
    <ProjectReference Include="..\SimpleGit11.Plugin.Ssh\SimpleGit11.Plugin.Ssh.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
  <Target Name="CopySshPluginFixture" AfterTargets="Build">
    <MSBuild Projects="..\SimpleGit11.Plugin.Ssh\SimpleGit11.Plugin.Ssh.csproj" Targets="GetPluginLayoutFiles" BuildInParallel="false">
      <Output TaskParameter="TargetOutputs" ItemName="_SshFixture" />
    </MSBuild>
    <Error Condition="'@(_SshFixture)' == ''" Text="The SSH plugin test fixture has not been built." />
    <Copy SourceFiles="@(_SshFixture)" DestinationFolder="$(TargetDir)PluginFixtures\Ssh" SkipUnchangedFiles="true" />
  </Target>
</Project>
