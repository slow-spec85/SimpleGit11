<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SimpleGit11.Controls.CommitBrowserToolbar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="HistoryViewToggleButtonStyle" TargetType="AppBarToggleButton" BasedOn="{StaticResource DefaultAppBarToggleButtonStyle}">
            <!-- The native template insets the button face by 2 horizontally and 6 vertically. -->
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <!-- Preserve the full coordinate space so the command bar centers the drawing at (8,8). -->
        <Style x:Key="HistoryPanePathIconStyle" TargetType="PathIcon">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <CommandBar
            x:Name="ViewCommands"
            VerticalAlignment="Center"
            Background="Transparent"
            DefaultLabelPosition="Collapsed"
            IsDynamicOverflowEnabled="False"
            OverflowButtonVisibility="Collapsed">
            <CommandBar.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Default">
                            <SolidColorBrush x:Key="AppBarToggleButtonBackgroundChecked" Color="{ThemeResource ControlAltFillColorQuarternary}" />
                            <SolidColorBrush x:Key="AppBarToggleButtonBackgroundCheckedPointerOver" Color="{ThemeResource ControlFillColorSecondary}" />
                            <SolidColorBrush x:Key="AppBarToggleButtonBackgroundCheckedPressed" Color="{ThemeResource ControlAltFillColorTertiary}" />
                            <SolidColorBrush x:Key="AppBarToggleButtonBackgroundCheckedDisabled" Color="{ThemeResource ControlFillColorDisabled}" />
                            <SolidColorBrush x:Key="AppBarToggleButtonForegroundChecked" Color="{ThemeResource TextFillColorPrimary}" />
                            <SolidColorBrush x:Key="AppBarToggleButtonForegroundCheckedPointerOver" Color="{ThemeResource TextFillColorPrimary}" />
                            <SolidColorBrush x:Key="AppBarToggleButtonForegroundCheckedPressed" Color="{ThemeResource TextFillColorSecondary}" />
                            <SolidColorBrush x:Key="AppBarToggleButtonForegroundCheckedDisabled" Color="{ThemeResource TextFillColorDisabled}" />
                            <SolidColorBrush x:Key="AppBarToggleButtonBorderBrushChecked" Color="Transparent" />
                            <SolidColorBrush x:Key="AppBarToggleButtonBorderBrushCheckedPointerOver" Color="Transparent" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="HighContrast">
                            <SolidColorBrush x:Key="AppBarToggleButtonBackgroundChecked" Color="{ThemeResource SystemColorHighlightColor}" />
                            <SolidColorBrush x:Key="AppBarToggleButtonBackgroundCheckedPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
                            <SolidColorBrush x:Key="AppBarToggleButtonBackgroundCheckedPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
                            <SolidColorBrush x:Key="AppBarToggleButtonBackgroundCheckedDisabled" Color="{ThemeResource SystemColorGrayTextColor}" />
                            <SolidColorBrush x:Key="AppBarToggleButtonForegroundChecked" Color="{ThemeResource SystemColorHighlightTextColor}" />
                            <SolidColorBrush x:Key="AppBarToggleButtonForegroundCheckedPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
                            <SolidColorBrush x:Key="AppBarToggleButtonForegroundCheckedPressed" Color="{ThemeResource SystemColorHighlightColor}" />
                            <SolidColorBrush x:Key="AppBarToggleButtonForegroundCheckedDisabled" Color="{ThemeResource SystemColorWindowColor}" />
                            <SolidColorBrush x:Key="AppBarToggleButtonBorderBrushChecked" Color="{ThemeResource SystemColorHighlightColor}" />
                            <SolidColorBrush x:Key="AppBarToggleButtonBorderBrushCheckedPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </CommandBar.Resources>
            <AppBarToggleButton
                x:Uid="HistoryCommitListToggleButton"
                AutomationProperties.AutomationId="HistoryCommitListToggleButton"
                Visibility="{x:Bind ViewModel.IsCommitHistoryAvailable, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                IsChecked="{x:Bind ViewModel.IsCommitListVisible, Mode=TwoWay}"
                Style="{StaticResource HistoryViewToggleButtonStyle}">
                <AppBarToggleButton.Icon>
                    <PathIcon
                        Style="{StaticResource HistoryPanePathIconStyle}"
                        Data="F0 M0,7.5 H4.25 V8.5 H0 Z M11.75,7.5 H16 V8.5 H11.75 Z M4.25,8 A3.75,3.75 0 1 1 11.75,8 A3.75,3.75 0 1 1 4.25,8 Z M5.25,8 A2.75,2.75 0 1 1 10.75,8 A2.75,2.75 0 1 1 5.25,8 Z" />
                </AppBarToggleButton.Icon>
            </AppBarToggleButton>
            <AppBarToggleButton
                x:Uid="HistoryFileListToggleButton"
                AutomationProperties.AutomationId="HistoryFileListToggleButton"
                IsChecked="{x:Bind ViewModel.IsFileListVisible, Mode=TwoWay}"
                Style="{StaticResource HistoryViewToggleButtonStyle}">
                <AppBarToggleButton.Icon>
                    <PathIcon
                        Style="{StaticResource HistoryPanePathIconStyle}"
                        Data="F0 M1,5 H2 V15 H11 V16 H1 Z M4,0 H10 L15,5 V13 H4 Z M5,1 V12 H14 V5.5 H9.5 V1 Z M10.5,1.91 V4.5 H13.09 Z" />
                </AppBarToggleButton.Icon>
            </AppBarToggleButton>
            <AppBarToggleButton
                x:Uid="HistoryDiffToggleButton"
                AutomationProperties.AutomationId="HistoryDiffToggleButton"
                IsChecked="{x:Bind ViewModel.IsDiffVisible, Mode=TwoWay}"
                Style="{StaticResource HistoryViewToggleButtonStyle}">
                <AppBarToggleButton.Icon>
                    <PathIcon
                        Style="{StaticResource HistoryPanePathIconStyle}"
                        Data="M7.5,1.5 H8.5 V5 H12 V6 H8.5 V9.5 H7.5 V6 H4 V5 H7.5 Z M4,13.5 H12 V14.5 H4 Z" />
                </AppBarToggleButton.Icon>
            </AppBarToggleButton>
            <AppBarToggleButton
                x:Name="CommitDetailsToggleButton"
                x:Uid="CommitDetailsToggleButton"
                AutomationProperties.AutomationId="HistoryCommitDetailsToggleButton"
                Visibility="{x:Bind ViewModel.IsCommitHistoryAvailable, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                IsChecked="{x:Bind ViewModel.IsCommitDetailsBlockVisible, Mode=TwoWay}"
                Style="{StaticResource HistoryViewToggleButtonStyle}">
                <AppBarToggleButton.Icon>
                    <FontIcon Glyph="&#xE946;" FontSize="16" />
                </AppBarToggleButton.Icon>
            </AppBarToggleButton>
        </CommandBar>

        <Border
            x:Name="ViewCommandsSeparator"
            Grid.Column="1"
            Width="1"
            Height="20"
            Margin="16,0"
            VerticalAlignment="Center"
            Background="{ThemeResource DividerStrokeColorDefaultBrush}"
            Visibility="{x:Bind ActionCommands.Visibility, Mode=OneWay, FallbackValue=Collapsed}" />

        <ContentPresenter
            Grid.Column="2"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Center"
            Content="{x:Bind ActionCommands, Mode=OneWay}" />
    </Grid>
</UserControl>
