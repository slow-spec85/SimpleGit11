<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SimpleGit11.Controls.CommitBrowserView"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SimpleGit11.Controls"
    xmlns:models="using:SimpleGit11.Models"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives" 
    xmlns:viewmodels="using:SimpleGit11.ViewModels" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=viewmodels:CommitBrowserViewModelBase}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <controls:DiffStatColumnMetrics x:Key="HistoryDiffStatColumnMetrics" />
    </UserControl.Resources>

    <Grid
        x:Name="PageLayout"
        Padding="0"
        DataContext="{x:Bind ViewModel, Mode=OneWay}"
        RowSpacing="20">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="NarrowLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HistorySearchColumn.Width" Value="*" />
                        <Setter Target="HistoryListsColumn.Width" Value="*" />
                        <Setter Target="HistoryDiffSplitterColumn.Width" Value="0" />
                        <Setter Target="HistoryDiffColumn.Width" Value="0" />
                        <Setter Target="HistoryDiffColumn.MinWidth" Value="0" />
                        <Setter Target="HistoryListsRow.Height" Value="2*" />
                        <Setter Target="HistoryDiffSplitterRow.Height" Value="8" />
                        <Setter Target="HistoryDiffRow.Height" Value="3*" />
                        <Setter Target="HistoryDiffSplitter.(Grid.Row)" Value="1" />
                        <Setter Target="HistoryDiffSplitter.(Grid.Column)" Value="0" />
                        <Setter Target="HistoryDiffSplitter.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="HistoryDiffSplitter.Style" Value="{StaticResource HorizontalSplitterStyle}" />
                        <Setter Target="HistoryDiffSplitter.Margin" Value="0,0,32,0" />
                        <Setter Target="HistoryContentGrid.ColumnSpacing" Value="0" />
                        <Setter Target="CommitListSplitter.Margin" Value="0,0,32,0" />
                        <Setter Target="HistoryRightPane.(Grid.Row)" Value="2" />
                        <Setter Target="HistoryRightPane.(Grid.Column)" Value="0" />
                        <Setter Target="HistoryRightPane.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="HistoryRightPane.Margin" Value="0,0,0,0" />
                        <Setter Target="CommitListHeader.Padding" Value="0,0,30,0" />
                        <Setter Target="HistoryCommitsListView.Padding" Value="0,0,30,0" />
                        <Setter Target="ChangedFilesHeader.Padding" Value="0,0,32,0" />
                        <Setter Target="HistoryChangedFilesListView.Padding" Value="0,0,30,0" />
                        <Setter Target="CommitDetailsHeader.Padding" Value="0,0,30,0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1060" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HistoryListsColumn.Width" Value="400" />
                        <Setter Target="HistoryDiffColumn.Width" Value="*" />
                        <Setter Target="HistoryListsRow.Height" Value="*" />
                        <Setter Target="HistoryDiffRow.Height" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="HistoryContentGrid"
            Grid.RowSpan="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="HistoryListsColumn" Width="400"/>
                <ColumnDefinition x:Name="HistoryDiffSplitterColumn" Width="8" />
                <ColumnDefinition x:Name="HistoryDiffColumn" Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="HistoryListsRow" Height="*" />
                <RowDefinition x:Name="HistoryDiffSplitterRow" Height="0" />
                <RowDefinition x:Name="HistoryDiffRow" Height="0" />
            </Grid.RowDefinitions>

            <Grid x:Name="HistoryListsPane">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="CommitsListsRow" Height="*" />
                    <RowDefinition x:Name="CommitListSplitterRow" Height="8" />
                    <RowDefinition x:Name="FilesListsRow" Height="*" />
                </Grid.RowDefinitions>

                <Grid x:Name="CommitListGrid" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid
                        x:Name="CommitListHeader"
                        ColumnSpacing="4"
                        Padding="0,0,14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            MaxLines="1" TextWrapping="WrapWholeWords"
                            VerticalAlignment="Center"
                            Style="{ThemeResource SubtitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.CommitsTitle, Mode=OneWay}" />
                        <ToggleButton
                            Grid.Column="1"
                            x:Name="CommitFilterToggleButton"
                            x:Uid="CommitFilterToggleButton"
                            Click="CommitFilterToggleButton_Click"
                            IsChecked="{x:Bind ViewModel.IsCommitFilterApplied, Mode=OneWay}"
                            Visibility="{Binding IsCommitListVisible, ElementName=PageRoot, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Width="32"
                            Height="32"
                            Padding="1">
                            <SymbolIcon Symbol="Find" />
                            <primitives:FlyoutBase.AttachedFlyout>
                                <Flyout Placement="BottomEdgeAlignedRight">
                                    <Flyout.FlyoutPresenterStyle>
                                        <Style TargetType="FlyoutPresenter">
                                            <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
                                            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                                        </Style>
                                    </Flyout.FlyoutPresenterStyle>
                                    <StackPanel Spacing="16">
                                        <TextBox
                                            x:Name="HistorySearchTextBox"
                                            x:Uid="HistorySearchTextBox"
                                            AutomationProperties.AutomationId="HistorySearchTextBox"
                                            Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <ToggleSwitch
                                            x:Uid="MainlineOnlyToggleSwitch"
                                            AutomationProperties.AutomationId="MainlineOnlyToggleSwitch"
                                            IsOn="{x:Bind ViewModel.IsMainlineOnly, Mode=TwoWay}" />
                                        <StackPanel Spacing="8">
                                            <TextBlock
                                                x:Uid="CommitDateFilterHeaderTextBlock"
                                                Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                            <Grid ColumnSpacing="8" RowSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock
                                                    x:Name="CommitDateFromTextBlock"
                                                    x:Uid="CommitDateFromTextBlock"
                                                    VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                                    <CalendarDatePicker
                                                        x:Uid="CommitDateFromPicker"
                                                        AutomationProperties.AutomationId="CommitDateFromPicker"
                                                        AutomationProperties.LabeledBy="{Binding ElementName=CommitDateFromTextBlock}"
                                                        Date="{x:Bind ViewModel.FilterFromDate, Mode=TwoWay}" 
                                                        Width="110" />
                                                    <Button
                                                        x:Uid="CommitTimeFromPicker"
                                                        Width="80"
                                                        Height="32"
                                                        HorizontalContentAlignment="Center"
                                                        AutomationProperties.AutomationId="CommitTimeFromPicker"
                                                        AutomationProperties.LabeledBy="{Binding ElementName=CommitDateFromTextBlock}"
                                                        Click="TimeFilterButton_Click"
                                                        Content="{x:Bind ViewModel.FilterFromTimeText, Mode=OneWay}"
                                                        IsEnabled="{x:Bind ViewModel.IsFilterFromTimeEnabled, Mode=OneWay}"
                                                        Padding="8,0">
                                                        <primitives:FlyoutBase.AttachedFlyout>
                                                            <TimePickerFlyout
                                                                ClockIdentifier="24HourClock"
                                                                Time="{x:Bind ViewModel.FilterFromTime, Mode=TwoWay}" />
                                                        </primitives:FlyoutBase.AttachedFlyout>
                                                    </Button>
                                                    <Button
                                                        x:Uid="ClearCommitDateFromButton"
                                                        Width="32"
                                                        Height="32"
                                                        AutomationProperties.AutomationId="ClearCommitDateFromButton"
                                                        Command="{x:Bind ViewModel.ClearFilterFromDateCommand, Mode=OneWay}"
                                                        IsEnabled="{x:Bind ViewModel.IsFilterFromTimeEnabled, Mode=OneWay}"
                                                        Padding="0">
                                                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                                                    </Button>
                                                </StackPanel>
                                                <TextBlock
                                                    Grid.Row="1"
                                                    x:Name="CommitDateToTextBlock"
                                                    x:Uid="CommitDateToTextBlock"
                                                    VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" Spacing="4">
                                                    <CalendarDatePicker
                                                        x:Uid="CommitDateToPicker"
                                                        AutomationProperties.AutomationId="CommitDateToPicker"
                                                        AutomationProperties.LabeledBy="{Binding ElementName=CommitDateToTextBlock}"
                                                        Date="{x:Bind ViewModel.FilterToDate, Mode=TwoWay}"
                                                        Width="110"/>
                                                    <Button
                                                        x:Uid="CommitTimeToPicker"
                                                        Width="80"
                                                        Height="32"
                                                        HorizontalContentAlignment="Center"
                                                        AutomationProperties.AutomationId="CommitTimeToPicker"
                                                        AutomationProperties.LabeledBy="{Binding ElementName=CommitDateToTextBlock}"
                                                        Click="TimeFilterButton_Click"
                                                        Content="{x:Bind ViewModel.FilterToTimeText, Mode=OneWay}"
                                                        IsEnabled="{x:Bind ViewModel.IsFilterToTimeEnabled, Mode=OneWay}"
                                                        Padding="8,0">
                                                        <primitives:FlyoutBase.AttachedFlyout>
                                                            <TimePickerFlyout
                                                                ClockIdentifier="24HourClock"
                                                                Time="{x:Bind ViewModel.FilterToTime, Mode=TwoWay}" />
                                                        </primitives:FlyoutBase.AttachedFlyout>
                                                    </Button>
                                                    <Button
                                                        x:Uid="ClearCommitDateToButton"
                                                        Width="32"
                                                        Height="32"
                                                        AutomationProperties.AutomationId="ClearCommitDateToButton"
                                                        Command="{x:Bind ViewModel.ClearFilterToDateCommand, Mode=OneWay}"
                                                        IsEnabled="{x:Bind ViewModel.IsFilterToTimeEnabled, Mode=OneWay}"
                                                        Padding="0">
                                                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                        <Button
                                            x:Uid="ResetCommitFiltersButton"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            AutomationProperties.AutomationId="ResetCommitFiltersButton"
                                            Command="{x:Bind ViewModel.ResetCommitFiltersCommand, Mode=OneWay}"
                                            IsEnabled="{x:Bind ViewModel.IsCommitFilterApplied, Mode=OneWay}" />
                                    </StackPanel>
                                </Flyout>
                            </primitives:FlyoutBase.AttachedFlyout>
                        </ToggleButton>
                        <ToggleButton
                            Grid.Column="2"
                            x:Name="CommitDetailsToggleButton"
                            x:Uid="CommitDetailsToggleButton"
                            AutomationProperties.AutomationId="CommitDetailsToggleButton"
                            Click="CommitDetailsToggleButton_Click"
                            IsChecked="{x:Bind ViewModel.IsCommitDetailsBlockVisible, Mode=TwoWay}"
                            Visibility="{Binding IsCommitListVisible, ElementName=PageRoot, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Width="32"
                            Height="32"
                            Padding="1">
                            <SymbolIcon Symbol="List" />
                        </ToggleButton>
                    </Grid>
                    <ListView
                        x:Name="HistoryCommitsListView"
                        Grid.Row="1"
                        ContextRequested="HistoryCommitsListView_ContextRequested"
                        ItemsSource="{x:Bind ViewModel.CommitRows, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedCommitRow, Mode=TwoWay}"
                        SelectionChanged="HistoryCommitsListView_SelectionChanged"
                        SelectionMode="Single"
                        Padding="0,0,10,0">
                        <ListView.ItemContainerStyle>
                            <Style
                                BasedOn="{StaticResource DefaultListViewItemStyle}"
                                TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Padding" Value="8,0,4,0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.Footer>
                            <ContentPresenter
                                HorizontalAlignment="Stretch"
                                Content="{Binding CommitListFooter, ElementName=PageRoot}" />
                        </ListView.Footer>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:CommitBrowserRowViewItem">
                                <Grid
                                    AutomationProperties.HelpText="{x:Bind AccessibleGraphDescription, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <controls:CommitGraphCell
                                        Graph="{x:Bind Graph, Mode=OneWay}"
                                        Visibility="{x:Bind ShowGraph, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                                    <StackPanel Grid.Column="1" Margin="4" Spacing="2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <FontIcon
                                                x:Uid="CommitRequiresSynchronizationIcon"
                                                Margin="0,0,4,0"
                                                FontSize="12"
                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                Glyph="&#xE74A;"
                                                Visibility="{x:Bind Commit.NeedsSynchronization, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneTime}" />
                                            <StackPanel 
                                                Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="2"
                                                Margin="0,0,4,0"
                                                Visibility="{x:Bind Commit.IsMerge, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneTime}">
                                                <Path
                                                    Width="12"
                                                    Height="14"
                                                    VerticalAlignment="Center"
                                                    Data="{StaticResource MergeCommitIconData}"
                                                    Fill="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                    Stretch="Uniform" />
                                                <TextBlock
                                                    x:Uid="MergeCommitParentCountTextBlock"
                                                    VerticalAlignment="Center"
                                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind Commit.ParentCount, Mode=OneTime}" />
                                            </StackPanel>
                                            <ItemsControl
                                                Grid.Column="2"
                                                ItemsSource="{x:Bind Commit.References, Mode=OneTime}"
                                                Visibility="{x:Bind Commit.HasReferences, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneTime}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:GitCommitReference">
                                                        <Grid
                                                            Margin="0,0,4,2"
                                                            MaxWidth="100"
                                                            ToolTipService.ToolTip="{x:Bind Name, Mode=OneTime}">
                                                            <Border
                                                                Background="{ThemeResource MetadataIndicatorBackgroundBrush}"
                                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="4" />
                                                            <Border
                                                                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="4"
                                                                Visibility="{x:Bind IsRemoteBranch, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneTime}" />
                                                            <Grid
                                                                Padding="5,1"
                                                                ColumnSpacing="4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="12" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <controls:BranchIcon
                                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                        Visibility="{x:Bind IsLocalBranch, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneTime}" />
                                                                    <controls:BranchIcon
                                                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                                        Visibility="{x:Bind IsRemoteBranch, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneTime}" />
                                                                    <FontIcon
                                                                        FontSize="10"
                                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                        Glyph="&#xE8EC;"
                                                                        Visibility="{x:Bind IsTag, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneTime}" />
                                                                    <TextBlock
                                                                        Grid.Column="1"
                                                                        MaxLines="1"
                                                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                                                        Text="{x:Bind DisplayName, Mode=OneTime}"
                                                                        TextTrimming="CharacterEllipsis" />
                                                            </Grid>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock
                                                Grid.Column="3"
                                                FontWeight="SemiBold"
                                                MaxLines="1"
                                                Text="{x:Bind Commit.Message, Mode=OneTime}"
                                                ToolTipService.ToolTip="{x:Bind Commit.Title, Mode=OneTime}"
                                                TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border
                                                Padding="6,1"
                                                Margin="0,0,4,0"
                                                Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                                CornerRadius="4"
                                                Visibility="{x:Bind Commit.HasRangeSideLabel, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneTime}">
                                                <TextBlock
                                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind Commit.RangeSideLabel, Mode=OneTime}" />
                                            </Border>
                                            <TextBlock
                                                Grid.Column="1"
                                                x:Name="AdditionalCommitInfo"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap">
                                                <Run Text="{x:Bind Commit.DisplayDate, Mode=OneTime}" />
                                                <Run Text="{x:Bind Commit.ShortHash, Mode=OneTime}" />
                                                <Run Text="{x:Bind Commit.AuthorName, Mode=OneTime}" />
                                                <ToolTipService.ToolTip>
                                                    <TextBlock>
                                                        <Run Text="{x:Bind Commit.DisplayDate, Mode=OneTime}" />
                                                        <Run Text="{x:Bind Commit.ShortHash, Mode=OneTime}" />
                                                        <Run Text="{x:Bind Commit.AuthorName, Mode=OneTime}" />   
                                                    </TextBlock>
                                                </ToolTipService.ToolTip>
                                            </TextBlock>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <primitives:Thumb
                    x:Name="CommitListSplitter"
                    Grid.Row="1"
                    DragDelta="FilesSplitter_DragDelta"
                    Style="{StaticResource HorizontalSplitterStyle}" />

                <Grid
                    Grid.Row="2"
                    RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid x:Name="ChangedFilesHeader" Padding="0,0,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            VerticalAlignment="Center"
                            MaxLines="1" TextWrapping="WrapWholeWords"
                            Style="{ThemeResource SubtitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.ChangedFilesTitle, Mode=OneWay}" />
                        <controls:DiffStatPresenter
                            Grid.Column="1"
                            Margin="0,0,10,0"
                            HorizontalAlignment="Right"
                            AddedText="{x:Bind ViewModel.ChangedFilesStat.AddedText, Mode=OneWay, FallbackValue=''}"
                            ColumnMetrics="{StaticResource HistoryDiffStatColumnMetrics}"
                            IsColumnWidthSource="True"
                            RemovedText="{x:Bind ViewModel.ChangedFilesStat.RemovedText, Mode=OneWay, FallbackValue=''}" />
                    </Grid>
                    <ListView
                        x:Name="HistoryChangedFilesListView"
                        Grid.Row="1"
                        ItemsSource="{x:Bind ViewModel.ChangedFiles, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedChangedFile, Mode=TwoWay}"
                        SelectionMode="Single"
                        Padding="0,0,10,0">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:GitChangedFile">
                                <Grid
                                    Padding="4"
                                    ColumnSpacing="10"
                                    ToolTipService.ToolTip="{x:Bind Tooltip, Mode=OneTime}">
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem
                                                Command="{Binding DataContext.ToggleChangeDisplayModeCommand, ElementName=HistoryChangedFilesListView}"
                                                CommandParameter="{x:Bind}"
                                                Icon="Document"
                                                Text="{Binding DataContext.ContextMenuDisplayModeText, ElementName=HistoryChangedFilesListView}" />
                                            <MenuFlyoutItem
                                                x:Uid="FileFilterModeMenuFlyoutItem"
                                                Command="{Binding DataContext.FilterByChangedFileCommand, ElementName=HistoryChangedFilesListView}"
                                                CommandParameter="{x:Bind}"
                                                Icon="Find"
                                                Visibility="{Binding IsCommitListVisible, ElementName=PageRoot, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem
                                                x:Uid="CopyNameMenuFlyoutItem"
                                                Command="{Binding DataContext.CopyTextCommand, ElementName=HistoryChangedFilesListView}"
                                                CommandParameter="{x:Bind FileName}"
                                                Icon="Copy" />
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Width="28"
                                        Height="28"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource MetadataIndicatorBackgroundBrush}"
                                        CornerRadius="4">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Text="{x:Bind StatusIndicator, Mode=OneTime}" />
                                    </Border>

                                    <StackPanel
                                        Grid.Column="1"
                                        Spacing="2">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            MaxLines="1"
                                            Text="{x:Bind FileName, Mode=OneTime}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            MaxLines="1"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Text="{x:Bind DirectoryPath, Mode=OneTime}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <controls:DiffStatPresenter
                                        Grid.Column="2"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        AddedText="{x:Bind Stat.AddedText, Mode=OneTime}"
                                        ColumnMetrics="{StaticResource HistoryDiffStatColumnMetrics}"
                                        RemovedText="{x:Bind Stat.RemovedText, Mode=OneTime}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

            </Grid>

            <primitives:Thumb
                x:Name="HistoryDiffSplitter"
                Grid.Column="1"
                DragDelta="DiffSplitter_DragDelta"
                Style="{StaticResource VerticalSplitterStyle}" />

            <Grid
                Grid.Column="2"
                x:Name="HistoryRightPane"
                Margin="12,0,0,0"
                SizeChanged="HistoryRightPane_SizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="CommitDetailsRow" Height="0" />
                    <RowDefinition x:Name="CommitDetailsSplitterRow" Height="0" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid
                    Grid.Row="0"
                    RowSpacing="8"
                    Padding="0,0,30,0"
                    Visibility="{x:Bind ViewModel.CommitDetailsBlockVisibility, Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel
                        x:Name="CommitDetailsHeader"
                        Orientation="Horizontal"
                        Spacing="4">
                        <TextBlock
                            x:Uid="CommitDetailsTitleTextBlock"
                            MaxLines="1" TextWrapping="WrapWholeWords"
                            VerticalAlignment="Center"
                            Style="{ThemeResource SubtitleTextBlockStyle}" />
                    </StackPanel>

                    <Grid
                        Grid.Row="1"
                        RowSpacing="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            x:Name="CommitMetadataTextBlock"
                            Margin="10,0,0,0"
                            FontFamily="Consolas"
                            TextWrapping="Wrap">
                            <TextBlock.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem
                                        x:Uid="CopyCommitDateMenuFlyoutItem"
                                        Command="{x:Bind ViewModel.CopyTextCommand, Mode=OneWay}"
                                        CommandParameter="{x:Bind ViewModel.SelectedCommitDate, Mode=OneWay}" />
                                    <MenuFlyoutItem
                                        x:Uid="CopyCommitAuthorMenuFlyoutItem"
                                        Command="{x:Bind ViewModel.CopyTextCommand, Mode=OneWay}"
                                        CommandParameter="{x:Bind ViewModel.SelectedCommitAuthor, Mode=OneWay}" />
                                    <MenuFlyoutItem
                                        x:Uid="CopyCommitHashMenuFlyoutItem"
                                        Command="{x:Bind ViewModel.CopyTextCommand, Mode=OneWay}"
                                        CommandParameter="{x:Bind ViewModel.SelectedCommitHash, Mode=OneWay}" />
                                </MenuFlyout>
                            </TextBlock.ContextFlyout>
                            <Run Text="{x:Bind ViewModel.SelectedCommitDate, Mode=OneWay}" />
                            <Run Text=" · " />
                            <Run Text="{x:Bind ViewModel.SelectedCommitAuthor, Mode=OneWay}" />
                            <Run Text=" · " />
                            <Run Text="{x:Bind ViewModel.SelectedCommitHash, Mode=OneWay}" />
                        </TextBlock>
                        <StackPanel
                            Grid.Row="1"
                            Margin="0,4,0,0"
                            Spacing="0"
                            Visibility="{x:Bind ViewModel.HasParentCommits, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                            <ScrollViewer
                                MaxHeight="100"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto"
                                VerticalScrollMode="Auto">
                                <ItemsControl
                                    x:Name="ParentCommitsItemsControl"
                                    x:Load="{x:Bind ViewModel.HasParentCommits, Mode=OneWay}"
                                    ItemsSource="{x:Bind ViewModel.ParentCommits, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="0" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="viewmodels:CommitParentViewItem">
                                            <Button
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Command="{Binding DataContext.NavigateToParentCommitCommand, ElementName=PageLayout}"
                                                CommandParameter="{x:Bind}"
                                                Padding="2"
                                                Style="{ThemeResource SubtleButtonStyle}"
                                                ToolTipService.ToolTip="{x:Bind Tooltip, Mode=OneTime}">
                                                <Button.ContextFlyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem
                                                            x:Uid="NavigateToParentCommitMenuFlyoutItem"
                                                            Command="{Binding DataContext.NavigateToParentCommitCommand, ElementName=PageLayout}"
                                                            CommandParameter="{x:Bind}" />
                                                        <MenuFlyoutItem
                                                            x:Uid="ShowMergedCommitsMenuFlyoutItem"
                                                            Click="ShowMergedCommitsMenuFlyoutItem_Click"
                                                            Icon="List"
                                                            Visibility="{x:Bind IsMergedHistory, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneTime}" />
                                                    </MenuFlyout>
                                                </Button.ContextFlyout>
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="16" />
                                                        <ColumnDefinition Width="100" />
                                                        <ColumnDefinition Width="54" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Viewbox
                                                        Width="16"
                                                        Height="16"
                                                        VerticalAlignment="Center">
                                                        <Canvas
                                                            Width="16"
                                                            Height="16">
                                                            <Ellipse
                                                                Width="5"
                                                                Height="5"
                                                                Canvas.Left="5.5"
                                                                Canvas.Top="1"
                                                                Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            <Rectangle
                                                                Width="1.5"
                                                                Height="4.5"
                                                                Canvas.Left="7.25"
                                                                Canvas.Top="5"
                                                                Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            <Ellipse
                                                                Width="6"
                                                                Height="6"
                                                                Canvas.Left="5"
                                                                Canvas.Top="9"
                                                                Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                                                                StrokeThickness="1.5" />
                                                        </Canvas>
                                                    </Viewbox>
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                                        Text="{x:Bind Relationship, Mode=OneTime}" />
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        FontFamily="Consolas"
                                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                                        Text="{x:Bind ShortHash, Mode=OneTime}" />
                                                    <TextBlock
                                                        Grid.Column="3"
                                                        VerticalAlignment="Center"
                                                        MaxLines="1"
                                                        Text="{x:Bind Title, Mode=OneTime}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>

                        <TextBox
                            Grid.Row="2"
                            x:Name="CommitMessageTextBox"
                            AcceptsReturn="True"
                            FontFamily="Consolas"
                            IsReadOnly="True"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            Text="{x:Bind ViewModel.SelectedCommitMessage, Mode=OneWay}"
                            TextWrapping="Wrap">
                            <TextBox.ContextFlyout>
                                <CommandBarFlyout Opening="CommitMessageContextFlyout_Opening">
                                    <CommandBarFlyout.SecondaryCommands>
                                        <AppBarButton
                                            x:Name="EditCommitMessageContextButton"
                                            x:Uid="EditCommitMessageContextButton"
                                            AutomationProperties.AutomationId="EditCommitMessageContextButton"
                                            Command="{x:Bind ViewModel.EditCommitMessageCommand, Mode=OneWay}"
                                            Icon="Edit"
                                            Visibility="Collapsed" />
                                        <AppBarSeparator
                                            x:Name="CommitMessageEditSeparator"
                                            Visibility="Collapsed" />
                                        <AppBarButton
                                            x:Name="CopyCommitMessageButton"
                                            x:Uid="CopyCommitMessageButton"
                                            Click="CopyCommitMessageButton_Click"
                                            Icon="Copy" />
                                    </CommandBarFlyout.SecondaryCommands>
                                </CommandBarFlyout>
                            </TextBox.ContextFlyout>
                        </TextBox>
                    </Grid>
                </Grid>

                <primitives:Thumb
                    x:Name="CommitDetailsSplitter"
                    Grid.Row="1"
                    DragDelta="CommitDetailsSplitter_DragDelta"
                    Style="{StaticResource HorizontalSplitterStyle}"
                    Visibility="{x:Bind ViewModel.CommitDetailsBlockVisibility, Mode=OneWay}"
                    Margin="0,0,30,0"/>

                <controls:DiffViewer
                    Grid.Row="2"
                    x:Name="HistoryDiffPane"
                    CopyTextCommand="{x:Bind ViewModel.CopyTextCommand, Mode=OneWay}"
                    DiffLinesSource="{x:Bind ViewModel.DiffLines, Mode=OneWay}"
                    EmptyMessage="{x:Bind ViewModel.DiffEmptyMessage, Mode=OneWay}"
                    FilePath="{x:Bind ViewModel.SelectedDiffFileTooltip, Mode=OneWay}"
                    HasEmptyState="{x:Bind ViewModel.HasDiffEmptyState, Mode=OneWay}"
                    IsFullFileMode="{x:Bind ViewModel.IsFullFileMode, Mode=OneWay}"
                    SyntaxHighlightingMode="{x:Bind ViewModel.SelectedSyntaxHighlightingMode, Mode=OneWay}"
                    ToggleFullFileCommand="{x:Bind ViewModel.ToggleFullFileCommand, Mode=OneWay}" />
            </Grid>
        </Grid>

    </Grid>
</UserControl>
