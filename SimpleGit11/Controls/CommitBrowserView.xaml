<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SimpleGit11.Controls.CommitBrowserView"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SimpleGit11.Controls"
    xmlns:models="using:SimpleGit11.Models"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives" 
    xmlns:viewmodels="using:SimpleGit11.ViewModels" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=viewmodels:CommitBrowserViewModelBase}"
    mc:Ignorable="d">

    <Grid
        x:Name="PageLayout"
        Padding="0"
        DataContext="{x:Bind ViewModel, Mode=OneWay}"
        RowSpacing="20">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="NarrowLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HistorySearchColumn.Width" Value="*" />
                        <Setter Target="HistoryListsColumn.Width" Value="*" />
                        <Setter Target="HistoryDiffSplitterColumn.Width" Value="0" />
                        <Setter Target="HistoryDiffColumn.Width" Value="0" />
                        <Setter Target="HistoryDiffColumn.MinWidth" Value="0" />
                        <Setter Target="HistoryListsRow.Height" Value="2*" />
                        <Setter Target="HistoryDiffSplitterRow.Height" Value="12" />
                        <Setter Target="HistoryDiffRow.Height" Value="3*" />
                        <Setter Target="HistoryDiffSplitter.(Grid.Row)" Value="1" />
                        <Setter Target="HistoryDiffSplitter.(Grid.Column)" Value="0" />
                        <Setter Target="HistoryDiffSplitter.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="HistoryDiffSplitter.Style" Value="{StaticResource HorizontalSplitterStyle}" />
                        <Setter Target="HistoryDiffSplitter.Margin" Value="0,0,32,0" />
                        <Setter Target="HistoryContentGrid.ColumnSpacing" Value="0" />
                        <Setter Target="CommitListSplitter.Margin" Value="0,0,32,0" />
                        <Setter Target="HistoryDiffPane.(Grid.Row)" Value="2" />
                        <Setter Target="HistoryDiffPane.(Grid.Column)" Value="0" />
                        <Setter Target="HistoryDiffPane.Padding" Value="0" />
                        <Setter Target="CommitListHeader.Padding" Value="0,0,32,0" />
                        <Setter Target="HistoryCommitsListView.Padding" Value="0,0,28,0" />
                        <Setter Target="ChangedFilesHeader.Padding" Value="0,0,32,0" />
                        <Setter Target="HistoryChangedFilesListView.Padding" Value="0,0,28,0" />
                        <Setter Target="CommitDetailsHeader.Padding" Value="0,0,32,0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1060" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HistoryListsColumn.Width" Value="400" />
                        <Setter Target="HistoryDiffColumn.Width" Value="*" />
                        <Setter Target="HistoryListsRow.Height" Value="*" />
                        <Setter Target="HistoryDiffRow.Height" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="HistoryContentGrid"
            Grid.RowSpan="3"
            ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="HistoryListsColumn" Width="400"/>
                <ColumnDefinition x:Name="HistoryDiffSplitterColumn" Width="12" />
                <ColumnDefinition x:Name="HistoryDiffColumn" Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="HistoryListsRow" Height="*" />
                <RowDefinition x:Name="HistoryDiffSplitterRow" Height="0" />
                <RowDefinition x:Name="HistoryDiffRow" Height="0" />
            </Grid.RowDefinitions>

            <Grid x:Name="HistoryListsPane">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="CommitsListsRow" Height="*" />
                    <RowDefinition x:Name="CommitListSplitterRow" Height="12" />
                    <RowDefinition x:Name="FilesListsRow" Height="*" />
                </Grid.RowDefinitions>

                <Grid x:Name="CommitListGrid" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid
                        x:Name="CommitListHeader"
                        MinHeight="40"
                        ColumnSpacing="12"
                        RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            MaxLines="1" TextWrapping="WrapWholeWords"
                            VerticalAlignment="Center"
                            Style="{ThemeResource SubtitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.CommitsTitle, Mode=OneWay}" />
                        <ToggleButton
                            Grid.Column="1"
                            x:Name="CommitFilterToggleButton"
                            x:Uid="CommitFilterToggleButton"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="CommitFilterToggleButton_Click"
                            IsChecked="{x:Bind ViewModel.IsCommitFilterApplied, Mode=OneWay}"
                            Visibility="{Binding IsCommitListVisible, ElementName=PageRoot, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <SymbolIcon Symbol="Find" />
                            <primitives:FlyoutBase.AttachedFlyout>
                                <Flyout Placement="BottomEdgeAlignedRight">
                                    <Flyout.FlyoutPresenterStyle>
                                        <Style TargetType="FlyoutPresenter">
                                            <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
                                            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                                        </Style>
                                    </Flyout.FlyoutPresenterStyle>
                                    <StackPanel Spacing="16">
                                        <TextBox
                                            x:Name="HistorySearchTextBox"
                                            x:Uid="HistorySearchTextBox"
                                            AutomationProperties.AutomationId="HistorySearchTextBox"
                                            Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <ToggleSwitch
                                            x:Uid="MainlineOnlyToggleSwitch"
                                            AutomationProperties.AutomationId="MainlineOnlyToggleSwitch"
                                            IsOn="{x:Bind ViewModel.IsMainlineOnly, Mode=TwoWay}" />
                                        <StackPanel Spacing="8">
                                            <TextBlock
                                                x:Uid="CommitDateFilterHeaderTextBlock"
                                                Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                            <Grid ColumnSpacing="8" RowSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock
                                                    x:Name="CommitDateFromTextBlock"
                                                    x:Uid="CommitDateFromTextBlock"
                                                    VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                                    <CalendarDatePicker
                                                        x:Uid="CommitDateFromPicker"
                                                        AutomationProperties.AutomationId="CommitDateFromPicker"
                                                        AutomationProperties.LabeledBy="{Binding ElementName=CommitDateFromTextBlock}"
                                                        Date="{x:Bind ViewModel.FilterFromDate, Mode=TwoWay}" 
                                                        Width="110" />
                                                    <Button
                                                        x:Uid="CommitTimeFromPicker"
                                                        Width="80"
                                                        Height="32"
                                                        HorizontalContentAlignment="Center"
                                                        AutomationProperties.AutomationId="CommitTimeFromPicker"
                                                        AutomationProperties.LabeledBy="{Binding ElementName=CommitDateFromTextBlock}"
                                                        Click="TimeFilterButton_Click"
                                                        Content="{x:Bind ViewModel.FilterFromTimeText, Mode=OneWay}"
                                                        IsEnabled="{x:Bind ViewModel.IsFilterFromTimeEnabled, Mode=OneWay}"
                                                        Padding="8,0">
                                                        <primitives:FlyoutBase.AttachedFlyout>
                                                            <TimePickerFlyout
                                                                ClockIdentifier="24HourClock"
                                                                Time="{x:Bind ViewModel.FilterFromTime, Mode=TwoWay}" />
                                                        </primitives:FlyoutBase.AttachedFlyout>
                                                    </Button>
                                                    <Button
                                                        x:Uid="ClearCommitDateFromButton"
                                                        Width="32"
                                                        Height="32"
                                                        AutomationProperties.AutomationId="ClearCommitDateFromButton"
                                                        Command="{x:Bind ViewModel.ClearFilterFromDateCommand, Mode=OneWay}"
                                                        IsEnabled="{x:Bind ViewModel.IsFilterFromTimeEnabled, Mode=OneWay}"
                                                        Padding="0">
                                                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                                                    </Button>
                                                </StackPanel>
                                                <TextBlock
                                                    Grid.Row="1"
                                                    x:Name="CommitDateToTextBlock"
                                                    x:Uid="CommitDateToTextBlock"
                                                    VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" Spacing="4">
                                                    <CalendarDatePicker
                                                        x:Uid="CommitDateToPicker"
                                                        AutomationProperties.AutomationId="CommitDateToPicker"
                                                        AutomationProperties.LabeledBy="{Binding ElementName=CommitDateToTextBlock}"
                                                        Date="{x:Bind ViewModel.FilterToDate, Mode=TwoWay}"
                                                        Width="110"/>
                                                    <Button
                                                        x:Uid="CommitTimeToPicker"
                                                        Width="80"
                                                        Height="32"
                                                        HorizontalContentAlignment="Center"
                                                        AutomationProperties.AutomationId="CommitTimeToPicker"
                                                        AutomationProperties.LabeledBy="{Binding ElementName=CommitDateToTextBlock}"
                                                        Click="TimeFilterButton_Click"
                                                        Content="{x:Bind ViewModel.FilterToTimeText, Mode=OneWay}"
                                                        IsEnabled="{x:Bind ViewModel.IsFilterToTimeEnabled, Mode=OneWay}"
                                                        Padding="8,0">
                                                        <primitives:FlyoutBase.AttachedFlyout>
                                                            <TimePickerFlyout
                                                                ClockIdentifier="24HourClock"
                                                                Time="{x:Bind ViewModel.FilterToTime, Mode=TwoWay}" />
                                                        </primitives:FlyoutBase.AttachedFlyout>
                                                    </Button>
                                                    <Button
                                                        x:Uid="ClearCommitDateToButton"
                                                        Width="32"
                                                        Height="32"
                                                        AutomationProperties.AutomationId="ClearCommitDateToButton"
                                                        Command="{x:Bind ViewModel.ClearFilterToDateCommand, Mode=OneWay}"
                                                        IsEnabled="{x:Bind ViewModel.IsFilterToTimeEnabled, Mode=OneWay}"
                                                        Padding="0">
                                                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                        <Button
                                            x:Uid="ResetCommitFiltersButton"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            AutomationProperties.AutomationId="ResetCommitFiltersButton"
                                            Command="{x:Bind ViewModel.ResetCommitFiltersCommand, Mode=OneWay}"
                                            IsEnabled="{x:Bind ViewModel.IsCommitFilterApplied, Mode=OneWay}" />
                                    </StackPanel>
                                </Flyout>
                            </primitives:FlyoutBase.AttachedFlyout>
                        </ToggleButton>
                    </Grid>
                    <ListView
                        x:Name="HistoryCommitsListView"
                        Grid.Row="1"
                        ContextRequested="HistoryCommitsListView_ContextRequested"
                        ItemsSource="{x:Bind ViewModel.Commits, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedCommit, Mode=TwoWay}"
                        SelectionChanged="HistoryCommitsListView_SelectionChanged"
                        SelectionMode="Single">
                        <ListView.Footer>
                            <ContentPresenter
                                HorizontalAlignment="Stretch"
                                Content="{Binding CommitListFooter, ElementName=PageRoot}" />
                        </ListView.Footer>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:GitCommit">
                                <Grid Padding="4">
                                    <StackPanel Spacing="2">
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="4">
                                            <FontIcon
                                                x:Uid="CommitRequiresSynchronizationIcon"
                                                FontSize="12"
                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                Glyph="&#xE74A;"
                                                Visibility="{x:Bind NeedsSynchronization, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneTime}" />
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="2">
                                                <Path
                                                    Width="12"
                                                    Height="14"
                                                    VerticalAlignment="Center"
                                                    Data="{StaticResource MergeCommitIconData}"
                                                    Fill="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                    Stretch="Uniform"
                                                    Visibility="{x:Bind IsMerge, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneTime}" />
                                                <TextBlock
                                                    x:Uid="MergeCommitParentCountTextBlock"
                                                    VerticalAlignment="Center"
                                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind ParentCount, Mode=OneTime}"
                                                    Visibility="{x:Bind IsMerge, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneTime}" />
                                            </StackPanel>
                                            <ItemsControl
                                                ItemsSource="{x:Bind References, Mode=OneTime}"
                                                Visibility="{x:Bind HasReferences, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneTime}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:GitCommitReference">
                                                        <Grid
                                                            Margin="0,0,4,2"
                                                            MaxWidth="100"
                                                            ToolTipService.ToolTip="{x:Bind Name, Mode=OneTime}">
                                                            <Border
                                                                Background="{ThemeResource MetadataIndicatorBackgroundBrush}"
                                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="4" />
                                                            <Border
                                                                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="4"
                                                                Visibility="{x:Bind IsRemoteBranch, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneTime}" />
                                                            <Grid
                                                                Padding="5,1"
                                                                ColumnSpacing="4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="12" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <controls:BranchIcon
                                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                        Visibility="{x:Bind IsLocalBranch, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneTime}" />
                                                                    <controls:BranchIcon
                                                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                                        Visibility="{x:Bind IsRemoteBranch, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneTime}" />
                                                                    <FontIcon
                                                                        FontSize="10"
                                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                        Glyph="&#xE8EC;"
                                                                        Visibility="{x:Bind IsTag, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneTime}" />
                                                                    <TextBlock
                                                                        Grid.Column="1"
                                                                        MaxLines="1"
                                                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                                                        Text="{x:Bind DisplayName, Mode=OneTime}"
                                                                        TextTrimming="CharacterEllipsis" />
                                                            </Grid>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                MaxLines="1"
                                                Text="{x:Bind Message, Mode=OneTime}"
                                                ToolTipService.ToolTip="{x:Bind Title, Mode=OneTime}"
                                                TextTrimming="CharacterEllipsis" />
                                            
                                        </StackPanel>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border
                                                Padding="6,1"
                                                Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                                CornerRadius="4"
                                                Visibility="{x:Bind HasRangeSideLabel, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneTime}">
                                                <TextBlock
                                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind RangeSideLabel, Mode=OneTime}" />
                                            </Border>
                                            <TextBlock
                                                Grid.Column="1"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                Text="{x:Bind DisplayDate, Mode=OneTime}" />
                                            <TextBlock
                                                Grid.Column="2"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                Text="{x:Bind ShortHash, Mode=OneTime}" />
                                            <TextBlock
                                                Grid.Column="3"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                MaxLines="1"
                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                Text="{x:Bind AuthorName, Mode=OneTime}"
                                                TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <primitives:Thumb
                    x:Name="CommitListSplitter"
                    Grid.Row="1"
                    DragDelta="FilesSplitter_DragDelta"
                    Style="{StaticResource HorizontalSplitterStyle}" />

                <Grid
                    Grid.Row="2"
                    RowSpacing="12"
                    Visibility="{x:Bind ViewModel.ChangedFilesBlockVisibility, Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid x:Name="ChangedFilesHeader" Padding="0,0,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            VerticalAlignment="Center"
                            MaxLines="1" TextWrapping="WrapWholeWords"
                            Style="{ThemeResource SubtitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.ChangedFilesTitle, Mode=OneWay}" />
                        <Button
                            Grid.Column="1"
                            Margin="0,0,4,0"
                            x:Uid="ShowCommitDetailsBlockAppBarButton"
                            Command="{x:Bind ViewModel.ShowCommitDetailsBlockCommand, Mode=OneWay}"
                            Style="{ThemeResource SubtleButtonStyle}"
                            Width="36"
                            Height="36"
                            Padding="5">
                            <SymbolIcon Symbol="More" />
                        </Button>
                        <Grid
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="HistoryAddedLinesHeaderTextBlock"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource DiffAddedStatTextBrush}"
                                Text="{x:Bind ViewModel.ChangedFilesStat.AddedText, Mode=OneWay, FallbackValue=''}"
                                TextAlignment="Right" />
                            <TextBlock
                                x:Name="HistoryRemovedLinesHeaderTextBlock"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource DiffRemovedStatTextBrush}"
                                Text="{x:Bind ViewModel.ChangedFilesStat.RemovedText, Mode=OneWay, FallbackValue=''}"
                                TextAlignment="Right" />
                        </Grid>
                    </Grid>
                    <ListView
                        x:Name="HistoryChangedFilesListView"
                        Grid.Row="1"
                        ItemsSource="{x:Bind ViewModel.ChangedFiles, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedChangedFile, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:GitChangedFile">
                                <Grid
                                    Padding="4"
                                    ColumnSpacing="10"
                                    ToolTipService.ToolTip="{x:Bind Tooltip, Mode=OneTime}">
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem
                                                Command="{Binding DataContext.ToggleChangeDisplayModeCommand, ElementName=HistoryChangedFilesListView}"
                                                CommandParameter="{x:Bind}"
                                                Icon="Document"
                                                Text="{Binding DataContext.ContextMenuDisplayModeText, ElementName=HistoryChangedFilesListView}" />
                                            <MenuFlyoutItem
                                                x:Uid="FileFilterModeMenuFlyoutItem"
                                                Command="{Binding DataContext.FilterByChangedFileCommand, ElementName=HistoryChangedFilesListView}"
                                                CommandParameter="{x:Bind}"
                                                Icon="Find"
                                                Visibility="{Binding IsCommitListVisible, ElementName=PageRoot, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem
                                                x:Uid="CopyNameMenuFlyoutItem"
                                                Command="{Binding DataContext.CopyTextCommand, ElementName=HistoryChangedFilesListView}"
                                                CommandParameter="{x:Bind FileName}"
                                                Icon="Copy" />
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Width="28"
                                        Height="28"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource MetadataIndicatorBackgroundBrush}"
                                        CornerRadius="4">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Text="{x:Bind StatusIndicator, Mode=OneTime}" />
                                    </Border>

                                    <StackPanel
                                        Grid.Column="1"
                                        Spacing="2">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            MaxLines="1"
                                            Text="{x:Bind FileName, Mode=OneTime}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            MaxLines="1"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Text="{x:Bind DirectoryPath, Mode=OneTime}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <Grid
                                        Grid.Column="2"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        ColumnSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource DiffAddedStatTextBrush}"
                                            MinWidth="{Binding ActualWidth, ElementName=HistoryAddedLinesHeaderTextBlock}"
                                            Text="{x:Bind Stat.AddedText, Mode=OneTime}"
                                            TextAlignment="Right" />
                                        <TextBlock
                                            Grid.Column="1"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource DiffRemovedStatTextBrush}"
                                            MinWidth="{Binding ActualWidth, ElementName=HistoryRemovedLinesHeaderTextBlock}"
                                            Text="{x:Bind Stat.RemovedText, Mode=OneTime}"
                                            TextAlignment="Right" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <Grid
                    Grid.Row="2"
                    RowSpacing="8"
                    Visibility="{x:Bind ViewModel.CommitDetailsBlockVisibility, Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid x:Name="CommitDetailsHeader">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            x:Uid="CommitDetailsTitleTextBlock"
                            MaxLines="1" TextWrapping="WrapWholeWords"
                            VerticalAlignment="Center"
                            Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="4">
                            <Button
                                x:Uid="EditCommitMessageAppBarButton"
                                Command="{x:Bind ViewModel.EditCommitMessageCommand, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.EditCommitMessageActionVisibility, Mode=OneWay}"
                                Style="{ThemeResource SubtleButtonStyle}"
                                Padding="8">
                                <SymbolIcon Symbol="Edit" />
                            </Button>
                            <Button
                                x:Uid="ShowCommitFilesBlockAppBarButton"
                                Command="{x:Bind ViewModel.ShowChangedFilesBlockCommand, Mode=OneWay}"
                                Style="{ThemeResource SubtleButtonStyle}"
                                Padding="8">
                                <SymbolIcon Symbol="List" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid
                        Grid.Row="1"
                        RowSpacing="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="0">
                            <TextBlock
                                FontFamily="Consolas"
                                Text="{x:Bind ViewModel.SelectedCommitDate, Mode=OneWay}"
                                TextWrapping="WrapWholeWords"
                                Margin="10,0,0,0">
                                <TextBlock.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem
                                            x:Uid="CopyTextMenuFlyoutItem"
                                            Command="{x:Bind ViewModel.CopyTextCommand, Mode=OneWay}"
                                            CommandParameter="{x:Bind ViewModel.SelectedCommitDate, Mode=OneWay}" />
                                    </MenuFlyout>
                                </TextBlock.ContextFlyout>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel
                            Grid.Row="1"
                            Spacing="0">
                            <TextBlock
                                FontFamily="Consolas"
                                Text="{x:Bind ViewModel.SelectedCommitAuthor, Mode=OneWay}"
                                TextWrapping="WrapWholeWords"
                                Margin="10,0,0,0">
                                <TextBlock.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem
                                            x:Uid="CopyTextMenuFlyoutItem"
                                            Command="{x:Bind ViewModel.CopyTextCommand, Mode=OneWay}"
                                            CommandParameter="{x:Bind ViewModel.SelectedCommitAuthor, Mode=OneWay}" />
                                    </MenuFlyout>
                                </TextBlock.ContextFlyout>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel
                            Grid.Row="2"
                            Spacing="0">
                            <TextBlock
                                FontFamily="Consolas"
                                Text="{x:Bind ViewModel.SelectedCommitHash, Mode=OneWay}"
                                TextWrapping="WrapWholeWords"
                                Margin="10,0,0,0">
                                <TextBlock.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem
                                            x:Uid="CopyTextMenuFlyoutItem"
                                            Command="{x:Bind ViewModel.CopyTextCommand, Mode=OneWay}"
                                            CommandParameter="{x:Bind ViewModel.SelectedCommitHash, Mode=OneWay}" />
                                    </MenuFlyout>
                                </TextBlock.ContextFlyout>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel
                            Grid.Row="3"
                            Margin="0,4,0,0"
                            Spacing="0"
                            Visibility="{x:Bind ViewModel.HasParentCommits, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                            <ItemsControl
                                x:Name="ParentCommitsItemsControl"
                                x:Load="{x:Bind ViewModel.HasParentCommits, Mode=OneWay}"
                                ItemsSource="{x:Bind ViewModel.ParentCommits, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="0" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodels:CommitParentViewItem">
                                        <Button
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Command="{Binding DataContext.NavigateToParentCommitCommand, ElementName=PageLayout}"
                                            CommandParameter="{x:Bind}"
                                            Padding="2"
                                            Style="{ThemeResource SubtleButtonStyle}"
                                            ToolTipService.ToolTip="{x:Bind Tooltip, Mode=OneTime}">
                                            <Button.ContextFlyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem
                                                        x:Uid="NavigateToParentCommitMenuFlyoutItem"
                                                        Command="{Binding DataContext.NavigateToParentCommitCommand, ElementName=PageLayout}"
                                                        CommandParameter="{x:Bind}" />
                                                    <MenuFlyoutItem
                                                        x:Uid="ShowMergedCommitsMenuFlyoutItem"
                                                        Click="ShowMergedCommitsMenuFlyoutItem_Click"
                                                        Icon="List"
                                                        Visibility="{x:Bind IsMergedHistory, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneTime}" />
                                                </MenuFlyout>
                                            </Button.ContextFlyout>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="54" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Viewbox
                                                    Width="16"
                                                    Height="16"
                                                    VerticalAlignment="Center">
                                                    <Canvas
                                                        Width="16"
                                                        Height="16">
                                                        <Ellipse
                                                            Width="5"
                                                            Height="5"
                                                            Canvas.Left="5.5"
                                                            Canvas.Top="1"
                                                            Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <Rectangle
                                                            Width="1.5"
                                                            Height="4.5"
                                                            Canvas.Left="7.25"
                                                            Canvas.Top="5"
                                                            Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <Ellipse
                                                            Width="6"
                                                            Height="6"
                                                            Canvas.Left="5"
                                                            Canvas.Top="9"
                                                            Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                                                            StrokeThickness="1.5" />
                                                    </Canvas>
                                                </Viewbox>
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind Relationship, Mode=OneTime}" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    FontFamily="Consolas"
                                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind ShortHash, Mode=OneTime}" />
                                                <TextBlock
                                                    Grid.Column="3"
                                                    VerticalAlignment="Center"
                                                    MaxLines="1"
                                                    Text="{x:Bind Title, Mode=OneTime}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <TextBox
                            Grid.Row="4"
                            AcceptsReturn="True"
                            FontFamily="Consolas"
                            IsReadOnly="True"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            Text="{x:Bind ViewModel.SelectedCommitMessage, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </Grid>
                </Grid>
            </Grid>

            <primitives:Thumb
                x:Name="HistoryDiffSplitter"
                Grid.Column="1"
                DragDelta="DiffSplitter_DragDelta"
                Style="{StaticResource VerticalSplitterStyle}" />

            <controls:DiffViewer
                x:Name="HistoryDiffPane"
                Grid.Column="2"
                Padding="20,0,0,0"
                CopyTextCommand="{x:Bind ViewModel.CopyTextCommand, Mode=OneWay}"
                DiffLinesSource="{x:Bind ViewModel.DiffLines, Mode=OneWay}"
                EmptyMessage="{x:Bind ViewModel.DiffEmptyMessage, Mode=OneWay}"
                FilePath="{x:Bind ViewModel.SelectedDiffFileTooltip, Mode=OneWay}"
                HasEmptyState="{x:Bind ViewModel.HasDiffEmptyState, Mode=OneWay}"
                IsFullFileMode="{x:Bind ViewModel.IsFullFileMode, Mode=OneWay}"
                SyntaxHighlightingMode="{x:Bind ViewModel.SelectedSyntaxHighlightingMode, Mode=OneWay}" />
        </Grid>

    </Grid>
</UserControl>
