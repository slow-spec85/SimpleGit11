<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SimpleGit11.Controls.OperationProgressOverlay"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MaxWidth="720"
    HorizontalAlignment="Stretch"
    Visibility="{x:Bind IsRunning, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">

    <Border
        Padding="12"
        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ProgressRing
                Width="20"
                Height="20"
                VerticalAlignment="Center"
                IsActive="{x:Bind IsRunning, Mode=OneWay}" />

            <StackPanel
                Grid.Column="1"
                Spacing="4">
                <TextBlock
                    AutomationProperties.LiveSetting="Polite"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    MaxLines="1"
                    Text="{x:Bind Message, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <ProgressBar
                    MinWidth="160"
                    VerticalAlignment="Center"
                    IsIndeterminate="{x:Bind IsRunning, Mode=OneWay}" />
            </StackPanel>

            <Button
                x:Uid="CancelSynchronizationOperationButton"
                Grid.Column="2"
                VerticalAlignment="Center"
                Command="{x:Bind CancelCommand, Mode=OneWay}"
                Visibility="{x:Bind CancelButtonVisibility, Mode=OneWay}" />
        </Grid>
    </Border>
</UserControl>
