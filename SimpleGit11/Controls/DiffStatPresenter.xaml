<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SimpleGit11.Controls.DiffStatPresenter"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid ColumnSpacing="4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="AddedColumn" Width="Auto" />
            <ColumnDefinition x:Name="RemovedColumn" Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock
            x:Name="AddedTextElement"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            FontWeight="SemiBold"
            Foreground="{ThemeResource DiffAddedStatTextBrush}"
            SizeChanged="StatText_SizeChanged"
            Text="{x:Bind AddedText, Mode=OneWay}"
            TextAlignment="Right" />
        <TextBlock
            x:Name="RemovedTextElement"
            Grid.Column="1"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            FontWeight="SemiBold"
            Foreground="{ThemeResource DiffRemovedStatTextBrush}"
            SizeChanged="StatText_SizeChanged"
            Text="{x:Bind RemovedText, Mode=OneWay}"
            TextAlignment="Right" />
    </Grid>
</UserControl>
