<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SimpleGit11.Pages.RepositoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dialogs="using:SimpleGit11.Dialogs"
    xmlns:controls="using:SimpleGit11.Controls"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:viewmodels="using:SimpleGit11.ViewModels"
    NavigationCacheMode="Required">
    <Grid
        Padding="0,32,0,0"
        DataContext="{x:Bind ViewModel, Mode=OneWay}"
        RowSpacing="20">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="NarrowLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="CommandBarRow.Height" Value="Auto" />
                        <Setter Target="RepositoryCommands.(Grid.Row)" Value="1" />
                        <Setter Target="RepositoryCommands.(Grid.Column)" Value="0" />
                        <Setter Target="RepositoryCommands.Margin" Value="0,12,0,0" />
                        <Setter Target="RepositoryCommandsColumn.Width" Value="0" />
                        <Setter Target="RepositoryIdentityPanel.(Grid.Row)" Value="1" />
                        <Setter Target="RepositoryIdentityPanel.(Grid.Column)" Value="0" />
                        <Setter Target="RepositoryIdentityPanel.HorizontalAlignment" Value="Left" />
                        <Setter Target="RepositoryIdentityPanel.Margin" Value="0,20,0,0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1060" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16"
              Padding="32,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="RepositoryCommandsColumn" MaxWidth="800" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="CommandBarRow" Height="0" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="8">
                <TextBlock
                    x:Uid="RepositoryTitleTextBlock"
                    MaxLines="1"
                    Style="{ThemeResource TitleTextBlockStyle}"
                    TextWrapping="WrapWholeWords" />
                <TextBlock
                    x:Uid="RepositoryDescriptionTextBlock"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    MaxLines="2"
                    TextWrapping="WrapWholeWords" />
            </StackPanel>

            <CommandBar
                x:Name="RepositoryCommands"
                Grid.Column="1"
                Background="Transparent"
                DefaultLabelPosition="Right">
                <CommandBar.SecondaryCommands>
                    <AppBarButton
                        x:Uid="OpenRepositoryInNewWindowAppBarButton"
                        Command="{x:Bind ViewModel.OpenRepositoryInNewWindowCommand, Mode=OneWay}" />
                </CommandBar.SecondaryCommands>
                <AppBarButton
                    x:Uid="RefreshRepositoryAppBarButton"
                    Command="{x:Bind ViewModel.RefreshRepositoryCommand, Mode=OneWay}"
                    Icon="Refresh" />
                <AppBarButton
                    x:Uid="OpenRepositoryAppBarButton"
                    Command="{x:Bind ViewModel.OpenRepositoryCommand, Mode=OneWay}"
                    Icon="OpenFile" />
                <AppBarButton
                    x:Uid="CreateRepositoryAppBarButton"
                    Command="{x:Bind ViewModel.CreateRepositoryCommand, Mode=OneWay}"
                    Icon="Add" />
                <AppBarButton
                    x:Name="CloneRepositoryAppBarButton"
                    x:Uid="CloneRepositoryAppBarButton"
                    Icon="Download">
                    <AppBarButton.Flyout>
                        <dialogs:CloneRepositoryDialog />
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton
                    x:Uid="ArchiveRepositoryAppBarButton"
                    Command="{x:Bind ViewModel.ArchiveCommand, Mode=OneWay}"
                    Icon="Save" />
                <AppBarButton
                    x:Uid="CloseRepositoryAppBarButton"
                    Command="{x:Bind ViewModel.CloseRepositoryCommand, Mode=OneWay}"
                    Icon="Cancel" />
            </CommandBar>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      Padding="32,0">
            <Grid>
                <StackPanel Spacing="16" MaxWidth="1000">
                    <Grid
                        Padding="0,8,0,0"
                        ColumnSpacing="48">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <TextBlock
                                MaxLines="1"
                                Style="{ThemeResource TitleTextBlockStyle}"
                                Text="{x:Bind ViewModel.RepositoryName, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis">
                                <TextBlock.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem
                                            x:Uid="CopyTextMenuFlyoutItem"
                                            Command="{x:Bind ViewModel.CopyTextCommand, Mode=OneWay}"
                                            CommandParameter="{x:Bind ViewModel.RepositoryName, Mode=OneWay}"
                                            Icon="Copy" />
                                    </MenuFlyout>
                                </TextBlock.ContextFlyout>
                            </TextBlock>
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                MaxLines="1"
                                Text="{x:Bind ViewModel.RepositoryPathDisplayText, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="{x:Bind ViewModel.RepositoryPathDisplayText, Mode=OneWay}">
                                <TextBlock.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem
                                            x:Uid="CopyTextMenuFlyoutItem"
                                            Command="{x:Bind ViewModel.CopyRepositoryPathCommand, Mode=OneWay}"
                                            Icon="Copy" />
                                    </MenuFlyout>
                                </TextBlock.ContextFlyout>
                            </TextBlock>
                        </StackPanel>

                        <Grid
                            x:Name="RepositoryIdentityPanel"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon
                                FontSize="28"
                                Glyph="&#xE77B;"
                                VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    MaxLines="1"
                                    Text="{x:Bind ViewModel.CurrentUser, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis">
                                    <TextBlock.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem
                                                x:Uid="CopyTextMenuFlyoutItem"
                                                Command="{x:Bind ViewModel.CopyTextCommand, Mode=OneWay}"
                                                CommandParameter="{x:Bind ViewModel.CurrentUser, Mode=OneWay}"
                                                Icon="Copy" />
                                        </MenuFlyout>
                                    </TextBlock.ContextFlyout>
                                </TextBlock>
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    MaxLines="1"
                                    Text="{x:Bind ViewModel.CurrentEmail, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis">
                                    <TextBlock.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem
                                                x:Uid="CopyTextMenuFlyoutItem"
                                                Command="{x:Bind ViewModel.CopyTextCommand, Mode=OneWay}"
                                                CommandParameter="{x:Bind ViewModel.CurrentEmail, Mode=OneWay}"
                                                Icon="Copy" />
                                        </MenuFlyout>
                                    </TextBlock.ContextFlyout>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <StackPanel Spacing="0">
                            <toolkit:SettingsCard
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="0"
                                Padding="16,26">
                                <toolkit:SettingsCard.HeaderIcon>
                                    <SymbolIcon Symbol="PreviewLink" />
                                </toolkit:SettingsCard.HeaderIcon>
                                <toolkit:SettingsCard.Header>
                                    <StackPanel VerticalAlignment="Center" Spacing="4">
                                        <TextBlock
                                            x:Uid="RepositoryStatusSectionTitleTextBlock"
                                            MaxLines="1"
                                            Style="{ThemeResource SubtitleTextBlockStyle}"
                                            TextWrapping="WrapWholeWords" />
                                        <TextBlock
                                            x:Uid="RepositoryStatusSectionDescriptionTextBlock"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            MaxLines="1"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </toolkit:SettingsCard.Header>
                            </toolkit:SettingsCard>

                            <toolkit:SettingsCard
                                AllowFocusOnInteraction="False"
                                AutomationProperties.AutomationId="RemoteStatusSettingsCard"
                                Background="Transparent"
                                BorderThickness="0,1,0,0" 
                                BorderBrush="{ThemeResource CardBorderColorDefaultBrush}"
                                Click="RepositoryStateSettingsCard_Click"
                                CornerRadius="0"
                                IsClickEnabled="True"
                                Padding="60,0,16,0">
                                <toolkit:SettingsCard.Header>
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            Text="{x:Bind ViewModel.RepositoryState, Mode=OneWay}"
                                            TextWrapping="WrapWholeWords" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Text="{x:Bind ViewModel.CurrentBranch, Mode=OneWay}" />
                                    </StackPanel>
                                </toolkit:SettingsCard.Header>
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard
                                AllowFocusOnInteraction="False"
                                Background="Transparent"
                                BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardBorderColorDefaultBrush}"
                                Click="LastCommitSettingsCard_Click"
                                CornerRadius="0"
                                IsClickEnabled="True"
                                Padding="60,0,16,0">
                                <toolkit:SettingsCard.Header>
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            MaxLines="2"
                                            Text="{x:Bind ViewModel.LastCommitSummary, Mode=OneWay}"
                                            TextWrapping="WrapWholeWords">
                                            <TextBlock.ContextFlyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem
                                                        x:Uid="CopyTextMenuFlyoutItem"
                                                        Command="{x:Bind ViewModel.CopyTextCommand, Mode=OneWay}"
                                                        CommandParameter="{x:Bind ViewModel.LastCommitSummary, Mode=OneWay}"
                                                        Icon="Copy" />
                                                </MenuFlyout>
                                            </TextBlock.ContextFlyout>
                                        </TextBlock>
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            MaxLines="1"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Text="{x:Bind ViewModel.LastCommitDetails, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </toolkit:SettingsCard.Header>
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard
                                AllowFocusOnInteraction="False"
                                Background="Transparent"
                                BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardBorderColorDefaultBrush}"
                                Click="RemoteStatusSettingsCard_Click"
                                CornerRadius="0,0,4,4"
                                IsClickEnabled="True"
                                Padding="60,8,16,8">
                                <toolkit:SettingsCard.Header>
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            Text="{x:Bind ViewModel.TrackingSummary, Mode=OneWay}"
                                            TextWrapping="WrapWholeWords" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            MaxLines="1"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Text="{x:Bind ViewModel.TrackingUrl, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.TrackingUrl, Mode=OneWay}">
                                            <TextBlock.ContextFlyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem
                                                        x:Uid="CopyTextMenuFlyoutItem"
                                                        Command="{x:Bind ViewModel.CopyTextCommand, Mode=OneWay}"
                                                        CommandParameter="{x:Bind ViewModel.TrackingUrl, Mode=OneWay}"
                                                        Icon="Copy" />
                                                </MenuFlyout>
                                            </TextBlock.ContextFlyout>
                                        </TextBlock>
                                        <StackPanel
                                            Margin="0,8,0,0"
                                            Spacing="4"
                                            Visibility="{x:Bind ViewModel.HasPushTarget, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                                            <TextBlock
                                                x:Uid="RepositoryPushDetailsTitleTextBlock"
                                                Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock
                                                Text="{x:Bind ViewModel.PushSummary, Mode=OneWay}"
                                                TextWrapping="WrapWholeWords" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                MaxLines="1"
                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                Text="{x:Bind ViewModel.PushUrl, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTipService.ToolTip="{x:Bind ViewModel.PushUrl, Mode=OneWay}">
                                                <TextBlock.ContextFlyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem
                                                            x:Uid="CopyTextMenuFlyoutItem"
                                                            Command="{x:Bind ViewModel.CopyTextCommand, Mode=OneWay}"
                                                            CommandParameter="{x:Bind ViewModel.PushUrl, Mode=OneWay}"
                                                            Icon="Copy" />
                                                    </MenuFlyout>
                                                </TextBlock.ContextFlyout>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </toolkit:SettingsCard.Header>
                            </toolkit:SettingsCard>
                        </StackPanel>
                    </Border>

                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <StackPanel Spacing="0">
                            <toolkit:SettingsCard
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="0"
                                Padding="16,26">
                                <toolkit:SettingsCard.HeaderIcon>
                                    <SymbolIcon Symbol="Globe" />
                                </toolkit:SettingsCard.HeaderIcon>
                                <toolkit:SettingsCard.Header>
                                    <StackPanel VerticalAlignment="Center" Spacing="4">
                                        <TextBlock
                                            x:Uid="RemotesCardTitleTextBlock"
                                            MaxLines="1"
                                            Style="{ThemeResource SubtitleTextBlockStyle}"
                                            TextWrapping="WrapWholeWords" />
                                        <TextBlock
                                            x:Uid="RemotesCardDescriptionTextBlock"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            MaxLines="1"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </toolkit:SettingsCard.Header>
                                <toolkit:SettingsCard.Content>
                                    <Button
                                        x:Uid="AddRemoteButton"
                                        Width="140"
                                        VerticalAlignment="Center"
                                        Command="{x:Bind ViewModel.AddRemoteCommand, Mode=OneWay}" />
                                </toolkit:SettingsCard.Content>
                            </toolkit:SettingsCard>

                            <ItemsControl ItemsSource="{x:Bind ViewModel.RemoteViewItems, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodels:RemoteViewItem">
                                        <toolkit:SettingsCard
                                            Background="Transparent"
                                            BorderThickness="0,1,0,0"
                                            BorderBrush="{ThemeResource CardBorderColorDefaultBrush}"
                                            CornerRadius="0"
                                            Padding="60,10,16,10">
                                            <toolkit:SettingsCard.Header>
                                                <StackPanel Spacing="2" ToolTipService.ToolTip="{x:Bind ReferenceText, Mode=OneTime}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <TextBlock
                                                            Text="{x:Bind Name, Mode=OneTime}"
                                                            TextTrimming="CharacterEllipsis"
                                                            VerticalAlignment="Center">
                                                            <TextBlock.ContextFlyout>
                                                                <MenuFlyout>
                                                                    <MenuFlyoutItem
                                                                        x:Uid="CopyTextMenuFlyoutItem"
                                                                        Command="{x:Bind CopyTextCommand, Mode=OneTime}"
                                                                        CommandParameter="{x:Bind Name, Mode=OneTime}"
                                                                        Icon="Copy" />
                                                                </MenuFlyout>
                                                            </TextBlock.ContextFlyout>
                                                        </TextBlock>
                                                        <TextBlock
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="·"
                                                            VerticalAlignment="Center"
                                                            Visibility="{x:Bind CurrentStatusVisibility, Mode=OneTime}" />
                                                        <TextBlock
                                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                                            Text="{x:Bind CurrentStatusText, Mode=OneTime}"
                                                            VerticalAlignment="Center"
                                                            Visibility="{x:Bind CurrentStatusVisibility, Mode=OneTime}" />
                                                    </StackPanel>
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                                        Text="{x:Bind ReferenceText, Mode=OneTime}"
                                                        TextTrimming="CharacterEllipsis">
                                                        <TextBlock.ContextFlyout>
                                                            <MenuFlyout>
                                                                <MenuFlyoutItem
                                                                    x:Uid="CopyTextMenuFlyoutItem"
                                                                    Command="{x:Bind CopyTextCommand, Mode=OneTime}"
                                                                    CommandParameter="{x:Bind ReferenceText, Mode=OneTime}"
                                                                    Icon="Copy" />
                                                            </MenuFlyout>
                                                        </TextBlock.ContextFlyout>
                                                    </TextBlock>
                                                </StackPanel>
                                            </toolkit:SettingsCard.Header>
                                            <toolkit:SettingsCard.Content>
                                                <Button
                                                    x:Uid="RemoteActionsButton"
                                                    AutomationProperties.AutomationId="RemoteActionsButton"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,28,0">
                                                    <FontIcon Glyph="&#xE712;" />
                                                    <Button.Flyout>
                                                        <MenuFlyout>
                                                            <MenuFlyoutItem
                                                                x:Uid="SelectRemoteActionMenuFlyoutItem"
                                                                Command="{x:Bind SelectCommand}" />
                                                            <MenuFlyoutSeparator/>
                                                            <MenuFlyoutItem
                                                                x:Uid="RenameRemoteActionMenuFlyoutItem"
                                                                Command="{x:Bind RenameCommand, Mode=OneWay}" />
                                                            <MenuFlyoutItem
                                                                x:Uid="EditRemoteUrlActionMenuFlyoutItem"
                                                                Command="{x:Bind EditCommand, Mode=OneWay}" />
                                                            <MenuFlyoutItem
                                                                x:Uid="CheckRemoteAccessActionMenuFlyoutItem"
                                                                Command="{x:Bind CheckAccessCommand, Mode=OneWay}" />
                                                            <MenuFlyoutItem
                                                                x:Uid="RemoveRemoteActionMenuFlyoutItem"
                                                                Command="{x:Bind RemoveCommand, Mode=OneWay}" />
                                                        </MenuFlyout>
                                                    </Button.Flyout>
                                                </Button>
                                            </toolkit:SettingsCard.Content>
                                        </toolkit:SettingsCard>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <StackPanel Spacing="0">
                            <toolkit:SettingsCard
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="0"
                                Padding="16,26">
                                <toolkit:SettingsCard.HeaderIcon>
                                    <SymbolIcon Symbol="SyncFolder" />
                                </toolkit:SettingsCard.HeaderIcon>                                
                                <toolkit:SettingsCard.Header>
                                    <StackPanel VerticalAlignment="Center" Spacing="4">
                                        <TextBlock
                                            x:Uid="WorktreesCardTitleTextBlock"
                                            MaxLines="1"
                                            Style="{ThemeResource SubtitleTextBlockStyle}"
                                            TextWrapping="WrapWholeWords" />
                                        <TextBlock
                                            x:Uid="WorktreesCardDescriptionTextBlock"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            MaxLines="1"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </toolkit:SettingsCard.Header>
                                <toolkit:SettingsCard.Content>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button
                                            x:Uid="CreateWorktreeButton"
                                            Width="140"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Command="{x:Bind ViewModel.CreateWorktreeCommand, Mode=OneWay}" />
                                        <Button
                                            x:Uid="WorktreeSectionActionsButton"
                                            AutomationProperties.AutomationId="WorktreeSectionActionsButton"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE712;" />
                                            <Button.Flyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem
                                                        x:Uid="RepairWorktreesActionMenuFlyoutItem"
                                                        Command="{x:Bind ViewModel.RepairWorktreesCommand, Mode=OneWay}" />
                                                    <MenuFlyoutItem
                                                        x:Uid="PruneWorktreesActionMenuFlyoutItem"
                                                        Command="{x:Bind ViewModel.PruneWorktreesCommand, Mode=OneWay}" />
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </StackPanel>
                                </toolkit:SettingsCard.Content>

                            </toolkit:SettingsCard>

                            <ItemsControl ItemsSource="{x:Bind ViewModel.Worktrees, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodels:WorktreeViewItem">
                                        <toolkit:SettingsCard
                                            Background="Transparent"
                                            BorderThickness="0,1,0,0"
                                            BorderBrush="{ThemeResource CardBorderColorDefaultBrush}"
                                            CornerRadius="0"
                                            Padding="60,10,16,10">
                                            <toolkit:SettingsCard.Header>
                                                <StackPanel Spacing="2" ToolTipService.ToolTip="{x:Bind Path, Mode=OneTime}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <TextBlock
                                                            Text="{x:Bind Name, Mode=OneTime}"
                                                            TextTrimming="CharacterEllipsis"
                                                            VerticalAlignment="Center">
                                                            <TextBlock.ContextFlyout>
                                                                <MenuFlyout>
                                                                    <MenuFlyoutItem
                                                                        x:Uid="CopyTextMenuFlyoutItem"
                                                                        Command="{x:Bind CopyTextCommand, Mode=OneTime}"
                                                                        CommandParameter="{x:Bind Name, Mode=OneTime}"
                                                                        Icon="Copy" />
                                                                </MenuFlyout>
                                                            </TextBlock.ContextFlyout>
                                                        </TextBlock>
                                                        <TextBlock
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="·"
                                                            VerticalAlignment="Center" />
                                                        <TextBlock
                                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                                            Text="{x:Bind ReferenceText, Mode=OneTime}"
                                                            TextTrimming="CharacterEllipsis"
                                                            VerticalAlignment="Center" />
                                                        <TextBlock
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="·"
                                                            VerticalAlignment="Center" />
                                                        <TextBlock
                                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                                            Text="{x:Bind TypeText, Mode=OneTime}"
                                                            VerticalAlignment="Center" />
                                                        <TextBlock
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="·"
                                                            VerticalAlignment="Center"
                                                            Visibility="{x:Bind CurrentStatusVisibility, Mode=OneTime}" />
                                                        <TextBlock
                                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                                            Text="{x:Bind CurrentStatusText, Mode=OneTime}"
                                                            VerticalAlignment="Center"
                                                            Visibility="{x:Bind CurrentStatusVisibility, Mode=OneTime}" />
                                                        <TextBlock
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="·"
                                                            VerticalAlignment="Center"
                                                            Visibility="{x:Bind AuxiliaryStatusVisibility, Mode=OneTime}" />
                                                        <TextBlock
                                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                                            Text="{x:Bind AuxiliaryStatusText, Mode=OneTime}"
                                                            VerticalAlignment="Center"
                                                            Visibility="{x:Bind AuxiliaryStatusVisibility, Mode=OneTime}" />
                                                    </StackPanel>
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                                        Text="{x:Bind Path, Mode=OneTime}"
                                                        TextTrimming="CharacterEllipsis">
                                                        <TextBlock.ContextFlyout>
                                                            <MenuFlyout>
                                                                <MenuFlyoutItem
                                                                    x:Uid="CopyTextMenuFlyoutItem"
                                                                    Command="{x:Bind CopyTextCommand, Mode=OneTime}"
                                                                    CommandParameter="{x:Bind Path, Mode=OneTime}"
                                                                    Icon="Copy" />
                                                            </MenuFlyout>
                                                        </TextBlock.ContextFlyout>
                                                    </TextBlock>
                                                </StackPanel>
                                            </toolkit:SettingsCard.Header>
                                            <toolkit:SettingsCard.Content>
                                                <Button
                                                    x:Uid="WorktreeActionsButton"
                                                    AutomationProperties.AutomationId="WorktreeActionsButton"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,28,0">
                                                    <FontIcon Glyph="&#xE712;" />
                                                    <Button.Flyout>
                                                        <MenuFlyout>
                                                            <MenuFlyoutItem
                                                                x:Uid="OpenWorktreeActionMenuFlyoutItem"
                                                                Command="{x:Bind OpenCommand, Mode=OneTime}" />
                                                            <MenuFlyoutItem
                                                                x:Uid="OpenWorktreeFolderActionMenuFlyoutItem"
                                                                Command="{x:Bind OpenFolderCommand, Mode=OneTime}" />
                                                            <MenuFlyoutSeparator />
                                                            <MenuFlyoutItem
                                                                x:Uid="MoveWorktreeActionMenuFlyoutItem"
                                                                Command="{x:Bind MoveCommand, Mode=OneTime}" />
                                                            <MenuFlyoutItem
                                                                x:Uid="LockWorktreeActionMenuFlyoutItem"
                                                                Command="{x:Bind ToggleLockCommand, Mode=OneTime}"
                                                                Visibility="{x:Bind LockVisibility, Mode=OneTime}" />
                                                            <MenuFlyoutItem
                                                                x:Uid="UnlockWorktreeActionMenuFlyoutItem"
                                                                Command="{x:Bind ToggleLockCommand, Mode=OneTime}"
                                                                Visibility="{x:Bind UnlockVisibility, Mode=OneTime}" />
                                                            <MenuFlyoutSeparator />
                                                            <MenuFlyoutItem
                                                                x:Uid="RemoveWorktreeActionMenuFlyoutItem"
                                                                Command="{x:Bind RemoveCommand, Mode=OneTime}" />
                                                        </MenuFlyout>
                                                    </Button.Flyout>
                                                </Button>
                                            </toolkit:SettingsCard.Content>
                                        </toolkit:SettingsCard>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <StackPanel Spacing="0">
                            <toolkit:SettingsCard
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="0"
                                Padding="16,26">
                                <toolkit:SettingsCard.HeaderIcon>
                                    <SymbolIcon Symbol="Library" />
                                </toolkit:SettingsCard.HeaderIcon>
                                <toolkit:SettingsCard.Header>
                                    <StackPanel VerticalAlignment="Center" Spacing="4">
                                        <TextBlock
                                            x:Uid="SubmodulesCardTitleTextBlock"
                                            MaxLines="1"
                                            Style="{ThemeResource SubtitleTextBlockStyle}"
                                            TextWrapping="WrapWholeWords" />
                                        <TextBlock
                                            x:Uid="SubmodulesCardDescriptionTextBlock"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            MaxLines="1"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </toolkit:SettingsCard.Header>
                                <toolkit:SettingsCard.Content>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button
                                            x:Uid="AddSubmoduleButton"
                                            Width="140"
                                            Margin="0,0,8,0"
                                            Command="{x:Bind ViewModel.AddSubmoduleCommand, Mode=OneWay}" />
                                        <Button
                                            x:Uid="SubmoduleSectionActionsButton"
                                            AutomationProperties.AutomationId="SubmoduleSectionActionsButton"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE712;" />
                                            <Button.Flyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem
                                                        x:Uid="InitializeAllSubmodulesActionMenuFlyoutItem"
                                                        Command="{x:Bind ViewModel.InitializeAllSubmodulesCommand, Mode=OneWay}" />
                                                    <MenuFlyoutItem
                                                        x:Uid="CheckoutAllSubmodulesActionMenuFlyoutItem"
                                                        Command="{x:Bind ViewModel.CheckoutAllSubmodulesCommand, Mode=OneWay}" />
                                                    <MenuFlyoutItem
                                                        x:Uid="UpdateAllSubmodulesActionMenuFlyoutItem"
                                                        Command="{x:Bind ViewModel.UpdateAllSubmodulesCommand, Mode=OneWay}" />
                                                    <MenuFlyoutItem
                                                        x:Uid="SyncAllSubmodulesActionMenuFlyoutItem"
                                                        Command="{x:Bind ViewModel.SyncAllSubmodulesCommand, Mode=OneWay}" />
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </StackPanel>
                                </toolkit:SettingsCard.Content>
                            </toolkit:SettingsCard>

                            <TreeView
                                x:Uid="SubmoduleTreeView"
                                ItemsSource="{x:Bind ViewModel.Submodules, Mode=OneWay}"
                                IsEnabled="{x:Bind ViewModel.CanRunGitOperation, Mode=OneWay}"
                                SelectionMode="None"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                ScrollViewer.HorizontalScrollMode="Disabled"
                                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                ScrollViewer.VerticalScrollMode="Disabled"
                                Visibility="{x:Bind ViewModel.HasSubmodules, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                                <TreeView.Resources>
                                    <StaticResource
                                        x:Key="TreeViewItemBackgroundPointerOver"
                                        ResourceKey="SubtleFillColorTransparentBrush" />
                                    <StaticResource
                                        x:Key="TreeViewItemBackgroundPressed"
                                        ResourceKey="SubtleFillColorTransparentBrush" />
                                    <StaticResource
                                        x:Key="TreeViewItemBorderBrushPointerOver"
                                        ResourceKey="CardBorderColorDefaultBrush" />
                                    <StaticResource
                                        x:Key="TreeViewItemBorderBrushPressed"
                                        ResourceKey="CardBorderColorDefaultBrush" />
                                </TreeView.Resources>
                                <TreeView.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodels:SubmoduleViewItem">
                                        <TreeViewItem
                                            AutomationProperties.Name="{x:Bind AutomationName, Mode=OneTime}"
                                            BorderBrush="{ThemeResource CardBorderColorDefaultBrush}"
                                            BorderThickness="0,1,0,0"
                                            CornerRadius="0"
                                            HorizontalContentAlignment="Stretch"
                                            ItemsSource="{x:Bind Children, Mode=OneWay}">
                                            <Grid
                                                MinHeight="68"
                                                Padding="16,4"
                                                ColumnSpacing="12"
                                                ToolTipService.ToolTip="{x:Bind FullPath, Mode=OneTime}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock
                                                            Text="{x:Bind Name, Mode=OneTime}"
                                                            TextTrimming="CharacterEllipsis"
                                                            VerticalAlignment="Center">
                                                            <TextBlock.ContextFlyout>
                                                                <MenuFlyout>
                                                                    <MenuFlyoutItem
                                                                        x:Uid="CopyTextMenuFlyoutItem"
                                                                        Command="{x:Bind CopyTextCommand, Mode=OneTime}"
                                                                        CommandParameter="{x:Bind Name, Mode=OneTime}"
                                                                        Icon="Copy" />
                                                                </MenuFlyout>
                                                            </TextBlock.ContextFlyout>
                                                        </TextBlock>
                                                        <TextBlock
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="·"
                                                            VerticalAlignment="Center" />
                                                        <TextBlock
                                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                                            Text="{x:Bind StatusText, Mode=OneTime}"
                                                            VerticalAlignment="Center"
                                                            Visibility="{x:Bind IsStatusNeutral, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneTime}" />
                                                        <TextBlock
                                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                                            Text="{x:Bind StatusText, Mode=OneTime}"
                                                            VerticalAlignment="Center"
                                                            Visibility="{x:Bind IsStatusAccent, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneTime}" />
                                                        <TextBlock
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="·"
                                                            VerticalAlignment="Center" />
                                                        <TextBlock
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                                            Text="{x:Bind CommitText, Mode=OneTime}"
                                                            VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                                            Text="{x:Bind Url, Mode=OneTime}"
                                                            TextTrimming="CharacterEllipsis"
                                                            ToolTipService.ToolTip="{x:Bind Url, Mode=OneTime}">
                                                            <TextBlock.ContextFlyout>
                                                                <MenuFlyout>
                                                                    <MenuFlyoutItem
                                                                        x:Uid="CopyTextMenuFlyoutItem"
                                                                        Command="{x:Bind CopyTextCommand, Mode=OneTime}"
                                                                        CommandParameter="{x:Bind Url, Mode=OneTime}"
                                                                        Icon="Copy" />
                                                                </MenuFlyout>
                                                            </TextBlock.ContextFlyout>
                                                        </TextBlock>
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="·"
                                                            VerticalAlignment="Center" />
                                                        <TextBlock
                                                            Grid.Column="2"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                                            Text="{x:Bind BranchText, Mode=OneTime}"
                                                            VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <Button
                                                    Grid.Column="1"
                                                    x:Uid="SubmoduleActionsButton"
                                                    AutomationProperties.AutomationId="SubmoduleActionsButton"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,28,0">
                                                    <FontIcon Glyph="&#xE712;" />
                                                    <Button.Flyout>
                                                        <MenuFlyout>
                                                            <MenuFlyoutItem
                                                                x:Uid="OpenSubmoduleActionMenuFlyoutItem"
                                                                AutomationProperties.AutomationId="OpenSubmoduleAppBarButton"
                                                                Command="{x:Bind OpenCommand, Mode=OneTime}" />
                                                            <MenuFlyoutItem
                                                                x:Uid="OpenSubmoduleInNewWindowActionMenuFlyoutItem"
                                                                AutomationProperties.AutomationId="OpenSubmoduleInNewWindowAppBarButton"
                                                                Command="{x:Bind OpenInNewWindowCommand, Mode=OneTime}" />
                                                            <MenuFlyoutSeparator />
                                                            <MenuFlyoutItem
                                                                x:Uid="OpenSubmoduleFolderActionMenuFlyoutItem"
                                                                AutomationProperties.AutomationId="OpenSubmoduleFolderAppBarButton"
                                                                Command="{x:Bind OpenFolderCommand, Mode=OneTime}" />
                                                            <MenuFlyoutSeparator />
                                                            <MenuFlyoutItem
                                                                x:Uid="InitializeSubmoduleActionMenuFlyoutItem"
                                                                Command="{x:Bind InitializeCommand, Mode=OneTime}" />
                                                            <MenuFlyoutItem
                                                                x:Uid="CheckoutSubmoduleActionMenuFlyoutItem"
                                                                Command="{x:Bind CheckoutRecordedCommand, Mode=OneTime}" />
                                                            <MenuFlyoutItem
                                                                x:Uid="UpdateSubmoduleActionMenuFlyoutItem"
                                                                Command="{x:Bind UpdateFromRemoteCommand, Mode=OneTime}" />
                                                            <MenuFlyoutItem
                                                                x:Uid="SyncSubmoduleActionMenuFlyoutItem"
                                                                Command="{x:Bind SyncCommand, Mode=OneTime}" />
                                                            <MenuFlyoutSeparator />
                                                            <MenuFlyoutItem
                                                                x:Uid="EditSubmoduleUrlActionMenuFlyoutItem"
                                                                Command="{x:Bind EditUrlCommand, Mode=OneTime}" />
                                                            <MenuFlyoutItem
                                                                x:Uid="EditSubmoduleBranchActionMenuFlyoutItem"
                                                                Command="{x:Bind EditBranchCommand, Mode=OneTime}" />
                                                            <MenuFlyoutSeparator />
                                                            <MenuFlyoutItem
                                                                x:Uid="DeinitializeSubmoduleActionMenuFlyoutItem"
                                                                Command="{x:Bind DeinitializeCommand, Mode=OneTime}" />
                                                            <MenuFlyoutItem
                                                                x:Uid="RemoveSubmoduleActionMenuFlyoutItem"
                                                                Command="{x:Bind RemoveCommand, Mode=OneTime}" />
                                                        </MenuFlyout>
                                                    </Button.Flyout>
                                                </Button>
                                            </Grid>
                                        </TreeViewItem>
                                    </DataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </StackPanel>
                    </Border>

                    <toolkit:SettingsExpander
                        x:Name="RepositorySearchPane"
                        HorizontalContentAlignment="Stretch"
                        IsExpanded="True"
                        ItemsSource="{x:Bind ViewModel.FilteredFoundRepositories, Mode=OneWay}">
                        <toolkit:SettingsExpander.HeaderIcon>
                            <SymbolIcon Symbol="Folder" />
                        </toolkit:SettingsExpander.HeaderIcon>
                        <toolkit:SettingsExpander.Header>
                            <StackPanel Padding="0,10" Spacing="4">
                                <TextBlock
                                    x:Uid="RepositorySearchTitleTextBlock"
                                    MaxLines="1"
                                    Style="{ThemeResource SubtitleTextBlockStyle}"
                                    TextWrapping="WrapWholeWords" />
                                <TextBlock
                                    x:Uid="RepositorySearchDescriptionTextBlock"
                                    MaxLines="2"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </toolkit:SettingsExpander.Header>

                        <toolkit:SettingsExpander.Content>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox
                                    x:Uid="FoundRepositoryFilterTextBox"
                                    Height="32"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind ViewModel.FoundRepositoryFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button
                                        x:Uid="RefreshRepositorySearchButton"
                                        Width="140"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Command="{x:Bind ViewModel.SearchRepositoriesCommand, Mode=OneWay}" />
                                    <Button
                                        x:Uid="FoundRepositorySectionActionsButton"
                                        AutomationProperties.AutomationId="FoundRepositorySectionActionsButton"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE712;" />
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem
                                                    x:Uid="BrowseRepositorySearchStartPathActionMenuFlyoutItem"
                                                    Command="{x:Bind ViewModel.BrowseRepositorySearchStartPathCommand, Mode=OneWay}" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </toolkit:SettingsExpander.Content>

                        <toolkit:SettingsExpander.ItemsHeader>
                            <Grid>
                                <InfoBar
                                    x:Uid="NoFoundRepositoriesInfoBar"
                                    IsOpen="{x:Bind ViewModel.HasNoFoundRepositories, Mode=OneWay}"
                                    Severity="Informational"
                                    Visibility="{x:Bind ViewModel.HasNoFoundRepositories, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                                <InfoBar
                                    x:Uid="NoFilteredFoundRepositoriesInfoBar"
                                    IsOpen="{x:Bind ViewModel.HasNoFilteredFoundRepositories, Mode=OneWay}"
                                    Severity="Informational"
                                    Visibility="{x:Bind ViewModel.HasNoFilteredFoundRepositories, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                            </Grid>
                        </toolkit:SettingsExpander.ItemsHeader>

                        <toolkit:SettingsExpander.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:FoundRepositoryViewItem">
                                <toolkit:SettingsCard Padding="60,10,16,10">
                                    <toolkit:SettingsCard.Header>
                                        <StackPanel Spacing="2">
                                            <TextBlock
                                                MaxLines="1"
                                                Text="{x:Bind Name, Mode=OneTime}"
                                                TextTrimming="CharacterEllipsis">
                                                <TextBlock.ContextFlyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem
                                                            x:Uid="CopyTextMenuFlyoutItem"
                                                            Command="{x:Bind CopyNameCommand, Mode=OneTime}"
                                                            Icon="Copy" />
                                                    </MenuFlyout>
                                                </TextBlock.ContextFlyout>
                                            </TextBlock>
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                MaxLines="1"
                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                Text="{x:Bind Path, Mode=OneTime}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTipService.ToolTip="{x:Bind Path, Mode=OneTime}">
                                                <TextBlock.ContextFlyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem
                                                            x:Uid="CopyTextMenuFlyoutItem"
                                                            Command="{x:Bind CopyPathCommand, Mode=OneTime}"
                                                            Icon="Copy" />
                                                    </MenuFlyout>
                                                </TextBlock.ContextFlyout>
                                            </TextBlock>
                                        </StackPanel>
                                    </toolkit:SettingsCard.Header>
                                    <toolkit:SettingsCard.Content>
                                        <Button
                                            Grid.Column="1"
                                            x:Uid="FoundRepositoryActionsButton"
                                            AutomationProperties.AutomationId="FoundRepositoryActionsButton"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            VerticalAlignment="Center"
                                            Margin="0,0,28,0">
                                            <FontIcon Glyph="&#xE712;" />
                                            <Button.Flyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem
                                                        x:Uid="OpenFoundRepositoryActionMenuFlyoutItem"
                                                        Command="{x:Bind OpenCommand, Mode=OneTime}" />
                                                    <MenuFlyoutItem
                                                        x:Uid="OpenFoundRepositoryInNewWindowActionMenuFlyoutItem"
                                                        Command="{x:Bind OpenInNewWindowCommand, Mode=OneTime}" />
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem
                                                        x:Uid="OpenFoundRepositoryFolderActionMenuFlyoutItem"
                                                        Command="{x:Bind OpenFolderCommand, Mode=OneTime}" />
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </toolkit:SettingsCard.Content>
                                </toolkit:SettingsCard>
                            </DataTemplate>
                        </toolkit:SettingsExpander.ItemTemplate>
                    </toolkit:SettingsExpander>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
