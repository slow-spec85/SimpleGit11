<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SimpleGit11.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SimpleGit11.Controls"
    NavigationCacheMode="Required">

    <Page.Resources>
        <Style x:Key="HistoryEditButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="1" />
            <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        </Style>
    </Page.Resources>

    <Grid
        x:Name="PageLayout"
        Padding="0,32,0,0"
        RowSpacing="20">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="NarrowLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PageLayout.RowSpacing" Value="0" />
                        <Setter Target="HeaderCommands.(Grid.Row)" Value="1" />
                        <Setter Target="HeaderCommands.(Grid.Column)" Value="0" />
                        <Setter Target="HeaderCommands.HorizontalAlignment" Value="Left" />
                        <Setter Target="HeaderCommandsColumn.Width" Value="0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1060" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            Padding="32,0"
            ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="HeaderCommandsColumn" Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="8">
                <TextBlock
                    x:Uid="HistoryTitleTextBlock"
                    MaxLines="1"
                    Style="{ThemeResource TitleTextBlockStyle}"
                    TextWrapping="WrapWholeWords" />
                <TextBlock
                    x:Uid="HistoryDescriptionTextBlock"
                    MaxLines="2"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="WrapWholeWords" />
            </StackPanel>

            <CommandBar
                x:Name="HeaderCommands"
                Grid.Column="1"
                Background="Transparent"
                DefaultLabelPosition="Right">
                <AppBarButton
                    x:Uid="RefreshHistoryAppBarButton"
                    Width="100"
                    Command="{x:Bind ViewModel.RefreshHistoryCommand, Mode=OneWay}"
                    Icon="Refresh" />
                <AppBarButton
                    x:Uid="RevertCommitAppBarButton"
                    Command="{x:Bind ViewModel.RevertCommitCommand, Mode=OneWay}"
                    Icon="Undo" />
                <AppBarElementContainer>
                    <SplitButton
                        x:Uid="ResetSplitButton"
                        Command="{x:Bind ViewModel.ResetMixedCommand, Mode=OneWay}"
                        Style="{StaticResource SplitButtonCommandBarStyle}">
                        <SplitButton.Content>
                            <StackPanel Orientation="Horizontal">
                                <SymbolIcon Symbol="Refresh" />
                                <TextBlock
                                    x:Uid="ResetSplitButtonTextBlock"
                                    Margin="8,0,0,0" />
                            </StackPanel>
                        </SplitButton.Content>
                        <SplitButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem
                                    x:Uid="ResetSoftMenuFlyoutItem"
                                    Command="{x:Bind ViewModel.ResetSoftCommand, Mode=OneWay}"
                                    Icon="Upload" />
                                <MenuFlyoutItem
                                    x:Uid="ResetMixedMenuFlyoutItem"
                                    Command="{x:Bind ViewModel.ResetMixedCommand, Mode=OneWay}"
                                    Icon="Refresh" />
                                <MenuFlyoutItem
                                    x:Uid="ResetHardMenuFlyoutItem"
                                    Command="{x:Bind ViewModel.ResetHardCommand, Mode=OneWay}"
                                    Icon="Delete" />
                            </MenuFlyout>
                        </SplitButton.Flyout>
                    </SplitButton>
                </AppBarElementContainer>
                <CommandBar.SecondaryCommands>
                    <AppBarButton
                        x:Uid="EditHistoryAppBarButton"
                        AutomationProperties.AutomationId="StartHistoryEditButton"
                        Command="{x:Bind ViewModel.StartHistoryEditCommand, Mode=OneWay}"
                        Icon="Edit" />
                </CommandBar.SecondaryCommands>
            </CommandBar>
        </Grid>

        <StackPanel
            Grid.Row="1"
            Spacing="8"
            Padding="32,0">
            <InfoBar
                x:Uid="NoCommitsInfoBar"
                IsOpen="{x:Bind ViewModel.HasNoCommits, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.HasNoCommits, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" 
                Severity="Informational" />
        </StackPanel>

        <controls:CommitBrowserView
            x:Name="CommitBrowser"
            Grid.Row="1"
            Margin="32,0,0,0"
            ViewModel="{x:Bind ViewModel, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.HistoryVisible, Mode=OneWay}"
            ShowMergedCommitsRequested="CommitBrowser_ShowMergedCommitsRequested">
            <controls:CommitBrowserView.CommitListCommands>
                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                    <Button x:Uid="HistoryEditMoveUpButton" AutomationProperties.AutomationId="HistoryEditMoveUpButton" Style="{StaticResource HistoryEditButtonStyle}" Command="{x:Bind ViewModel.MoveDraftUpCommand, Mode=OneWay}">
                        <FontIcon Glyph="&#xE74A;" FontSize="16" />
                    </Button>
                    <Button x:Uid="HistoryEditMoveDownButton" AutomationProperties.AutomationId="HistoryEditMoveDownButton" Style="{StaticResource HistoryEditButtonStyle}" Command="{x:Bind ViewModel.MoveDraftDownCommand, Mode=OneWay}">
                        <FontIcon Glyph="&#xE74B;" FontSize="16" />
                    </Button>
                    <Button
                        x:Uid="HistoryEditMergeButton"
                        AutomationProperties.AutomationId="HistoryEditMergeButton"
                        Style="{StaticResource HistoryEditButtonStyle}"
                        Command="{x:Bind ViewModel.MergeDraftWithMessageCommand, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.MergeDraftTooltip, Mode=OneWay}">
                        <FontIcon Glyph="&#xE71B;" FontSize="16" />
                    </Button>
                    <Button
                        Style="{StaticResource HistoryEditButtonStyle}"
                        AutomationProperties.AutomationId="HistoryEditDeleteButton"
                        AutomationProperties.Name="{x:Bind ViewModel.DeleteDraftCaption, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.DeleteDraftCaption, Mode=OneWay}"
                        Command="{x:Bind ViewModel.DeleteDraftCommitCommand, Mode=OneWay}">
                        <FontIcon Glyph="{x:Bind ViewModel.DeleteDraftGlyph, Mode=OneWay}" FontSize="16" />
                    </Button>
                    <Button x:Uid="HistoryEditUndoButton" AutomationProperties.AutomationId="HistoryEditUndoButton" Style="{StaticResource HistoryEditButtonStyle}" Command="{x:Bind ViewModel.UndoHistoryEditCommand, Mode=OneWay}">
                        <SymbolIcon Symbol="Undo" />
                    </Button>
                    <Border
                        Width="1"
                        Height="20"
                        Margin="8,0"
                        VerticalAlignment="Center"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Button x:Uid="HistoryEditApplyButton" AutomationProperties.AutomationId="HistoryEditApplyButton" Style="{StaticResource HistoryEditButtonStyle}" Command="{x:Bind ViewModel.ApplyHistoryEditCommand, Mode=OneWay}">
                        <SymbolIcon Symbol="Accept" />
                    </Button>
                    <Button x:Uid="HistoryEditCancelButton" AutomationProperties.AutomationId="HistoryEditCancelButton" Style="{StaticResource HistoryEditButtonStyle}" Command="{x:Bind ViewModel.CancelHistoryEditCommand, Mode=OneWay}">
                        <SymbolIcon Symbol="Cancel" />
                    </Button>
                </StackPanel>
            </controls:CommitBrowserView.CommitListCommands>
            <controls:CommitBrowserView.CommitListFooter>
                <Button
                    Margin="0,12,0,0"
                    HorizontalAlignment="Center"
                    AutomationProperties.AutomationId="LoadMoreHistoryButton"
                    Command="{x:Bind ViewModel.LoadMoreHistoryCommand, Mode=OneWay}"
                    Content="{x:Bind ViewModel.LoadMoreCommitsButtonText, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsLoadMoreHistoryVisible, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
            </controls:CommitBrowserView.CommitListFooter>
            <controls:CommitBrowserView.CommitContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem
                        x:Uid="CheckoutCommitMenuFlyoutItem"
                        Command="{x:Bind ViewModel.CheckoutCommitCommand, Mode=OneWay}"
                        Icon="Switch" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        x:Uid="RevertCommitMenuFlyoutItem"
                        Command="{x:Bind ViewModel.RevertCommitCommand, Mode=OneWay}"
                        Icon="Undo" />
                    <SplitMenuFlyoutItem
                        x:Uid="ResetCommitSplitMenuFlyoutItem"
                        Command="{x:Bind ViewModel.ResetMixedCommand, Mode=OneWay}"
                        Icon="Refresh">
                        <MenuFlyoutItem
                            x:Uid="ResetSoftMenuFlyoutItem"
                            Command="{x:Bind ViewModel.ResetSoftCommand, Mode=OneWay}"
                            Icon="Upload" />
                        <MenuFlyoutItem
                            x:Uid="ResetMixedMenuFlyoutItem"
                            Command="{x:Bind ViewModel.ResetMixedCommand, Mode=OneWay}"
                            Icon="Refresh" />
                        <MenuFlyoutItem
                            x:Uid="ResetHardMenuFlyoutItem"
                            Command="{x:Bind ViewModel.ResetHardCommand, Mode=OneWay}"
                            Icon="Delete" />
                    </SplitMenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        x:Uid="HistoryQuickMergeMenuFlyoutItem"
                        AutomationProperties.AutomationId="HistoryQuickMergeMenuFlyoutItem"
                        Command="{x:Bind ViewModel.MergeCommitWithPreviousCommand, Mode=OneWay}"
                        Icon="Link" />
                    <MenuFlyoutItem
                        x:Uid="HistoryQuickDeleteMenuFlyoutItem"
                        AutomationProperties.AutomationId="HistoryQuickDeleteMenuFlyoutItem"
                        Command="{x:Bind ViewModel.DeleteHistoryCommitCommand, Mode=OneWay}"
                        Icon="Delete" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        x:Name="CommitGraphMenuFlyoutItem"
                        AutomationProperties.AutomationId="CommitGraphMenuFlyoutItem"
                        Command="{x:Bind ViewModel.ToggleCommitGraphCommand, Mode=OneWay}"
                        Text="{x:Bind ViewModel.CommitGraphToggleText, Mode=OneWay}" />
                </MenuFlyout>
            </controls:CommitBrowserView.CommitContextFlyout>
        </controls:CommitBrowserView>

    </Grid>
</Page>
