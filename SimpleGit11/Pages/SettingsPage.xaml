<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SimpleGit11.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:appControls="using:SimpleGit11.Controls"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:models="using:SimpleGit11.Models"
    NavigationCacheMode="Required">

    <Grid
        x:Name="RootLayout"
        DataContext="{x:Bind ViewModel, Mode=OneWay}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="NarrowLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PageContentGrid.Padding" Value="24,20" />
                        <Setter Target="ThemeComboBox.MinWidth" Value="0" />
                        <Setter Target="LanguageComboBox.MinWidth" Value="0" />
                        <Setter Target="EditorFontFamilyComboBox.MinWidth" Value="0" />
                        <Setter Target="InitialBranchNameTextBox.MinWidth" Value="0" />
                        <Setter Target="GlobalPushDefaultRemoteTextBox.MinWidth" Value="0" />
                        <Setter Target="RepositoryPushDefaultRemoteTextBox.MinWidth" Value="0" />
                        <Setter Target="GlobalUserNameTextBox.MinWidth" Value="0" />
                        <Setter Target="GlobalEmailTextBox.MinWidth" Value="0" />
                        <Setter Target="RepositoryUserNameTextBox.MinWidth" Value="0" />
                        <Setter Target="RepositoryEmailTextBox.MinWidth" Value="0" />
                        <Setter Target="RepositorySettingsStatus.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="SaveRepositorySettingsButton.(Grid.Row)" Value="1" />
                        <Setter Target="SaveRepositorySettingsButton.(Grid.Column)" Value="0" />
                        <Setter Target="SaveRepositorySettingsButton.HorizontalAlignment" Value="Left" />
                        <Setter Target="SaveRepositorySettingsButton.Margin" Value="0,8,0,0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1060" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <ScrollViewer>
            <Grid x:Name="PageContentGrid" Padding="32">
            <StackPanel
                MaxWidth="1000"
                Spacing="28">
                <StackPanel Spacing="8">
                    <TextBlock
                        x:Uid="SettingsTitleTextBlock"
                        Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBlock
                        x:Uid="SettingsDescriptionTextBlock"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        MaxLines="2"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>

                <StackPanel Spacing="12">
                    <TextBlock
                        x:Uid="AppearanceTitleTextBlock"
                        Margin="2,0,0,0"
                        Style="{ThemeResource SubtitleTextBlockStyle}" />

                    <controls:SettingsCard>
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE790;" />
                        </controls:SettingsCard.HeaderIcon>
                        <controls:SettingsCard.Header>
                            <TextBlock x:Uid="ThemeSettingsCardHeaderTextBlock" />
                        </controls:SettingsCard.Header>
                        <ComboBox
                            x:Name="ThemeComboBox"
                            MinWidth="220"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{x:Bind ViewModel.ThemeOptions, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedTheme, Mode=TwoWay}" />
                    </controls:SettingsCard>

                    <controls:SettingsCard>
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE774;" />
                        </controls:SettingsCard.HeaderIcon>
                        <controls:SettingsCard.Header>
                            <TextBlock x:Uid="LanguageSettingsCardHeaderTextBlock" />
                        </controls:SettingsCard.Header>
                        <ComboBox
                            x:Name="LanguageComboBox"
                            MinWidth="220"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{x:Bind ViewModel.LanguageOptions, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}" />
                    </controls:SettingsCard>

                    <InfoBar
                        x:Uid="LanguageRestartInfoBar"
                        IsOpen="{x:Bind ViewModel.IsLanguageRestartRequired, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsLanguageRestartRequired, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}"
                        Severity="Informational" />

                    <controls:SettingsCard>
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8D2;" />
                        </controls:SettingsCard.HeaderIcon>
                        <controls:SettingsCard.Header>
                            <StackPanel Spacing="4">
                                <TextBlock x:Uid="EditorFontSettingsCardHeaderTextBlock" />
                                <TextBlock
                                    x:Uid="EditorFontSettingsCardDescriptionTextBlock"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </controls:SettingsCard.Header>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                x:Name="EditorFontFamilyComboBox"
                                x:Uid="EditorFontFamilyComboBox"
                                MinWidth="160"
                                AutomationProperties.AutomationId="EditorFontFamilySelector"
                                ItemsSource="{x:Bind ViewModel.EditorFontFamilyOptions, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedEditorFontFamily, Mode=TwoWay}" />
                            <NumberBox
                                x:Name="EditorFontSizeNumberBox"
                                x:Uid="EditorFontSizeNumberBox"
                                Grid.Column="1"
                                Width="96"
                                AutomationProperties.AutomationId="EditorFontSizeInput"
                                Maximum="32"
                                Minimum="8"
                                SmallChange="1"
                                SpinButtonPlacementMode="Compact"
                                Value="{x:Bind ViewModel.EditorFontSize, Mode=TwoWay}" />
                        </Grid>
                    </controls:SettingsCard>

                    <controls:SettingsCard>
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8D2;" />
                        </controls:SettingsCard.HeaderIcon>
                        <controls:SettingsCard.Header>
                            <StackPanel Spacing="4">
                                <TextBlock x:Uid="EditorLineSpacingSettingsCardHeaderTextBlock" />
                                <TextBlock
                                    x:Uid="EditorLineSpacingSettingsCardDescriptionTextBlock"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </controls:SettingsCard.Header>
                        <NumberBox
                            x:Name="EditorLineSpacingNumberBox"
                            x:Uid="EditorLineSpacingNumberBox"
                            Width="96"
                            AutomationProperties.AutomationId="EditorLineSpacingInput"
                            Maximum="16"
                            Minimum="0"
                            SmallChange="1"
                            SpinButtonPlacementMode="Compact"
                            Value="{x:Bind ViewModel.EditorLineSpacing, Mode=TwoWay}" />
                    </controls:SettingsCard>
                </StackPanel>

                <StackPanel Spacing="12">
                    <TextBlock
                        Margin="2,0,0,0"
                        Style="{ThemeResource SubtitleTextBlockStyle}"
                        Text="{x:Bind ViewModel.GlobalGitSettingsTitle, Mode=OneWay}" />

                    <controls:SettingsExpander IsExpanded="False">
                        <controls:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE713;" />
                        </controls:SettingsExpander.HeaderIcon>
                        <controls:SettingsExpander.Header>
                            <StackPanel>
                                <TextBlock x:Uid="GlobalRepositorySettingsTitleTextBlock" />
                                <TextBlock x:Uid="GlobalRepositorySettingsTitleDescriptionTextBlock"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="WrapWholeWords" />
                            </StackPanel>

                        </controls:SettingsExpander.Header>
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard>
                                <controls:SettingsCard.Header>
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Uid="InitialBranchNameSettingsCardHeaderTextBlock" />
                                        <TextBlock x:Uid="InitialBranchNameSettingsCardHeaderDescriptionTextBlock"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   FontSize="12"
                                                   TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </controls:SettingsCard.Header>
                                <TextBox
                                    x:Name="InitialBranchNameTextBox"
                                    x:Uid="InitialBranchNameSettingsTextBox"
                                    MinWidth="260"
                                    Text="{x:Bind ViewModel.InitialBranchName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </controls:SettingsCard>

                            <controls:SettingsCard>
                                <controls:SettingsCard.Header>
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Uid="GlobalPushDefaultRemoteSettingsCardHeaderTextBlock" />
                                        <TextBlock
                                            x:Uid="GlobalPushDefaultRemoteSettingsCardHeaderDescriptionTextBlock"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </controls:SettingsCard.Header>
                                <TextBox
                                    x:Name="GlobalPushDefaultRemoteTextBox"
                                    x:Uid="GlobalPushDefaultRemoteSettingsTextBox"
                                    MinWidth="260"
                                    AutomationProperties.AutomationId="GlobalPushDefaultRemote"
                                    Text="{x:Bind ViewModel.GlobalPushDefaultRemote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </controls:SettingsCard>

                            <controls:SettingsCard IsEnabled="{x:Bind ViewModel.IsGlobalPullSettingsLoaded, Mode=OneWay}">
                                <ToolTipService.ToolTip>
                                    <ToolTip MaxWidth="480">
                                        <TextBlock
                                            x:Uid="PullRebaseDetailsTextBlock"
                                            TextWrapping="WrapWholeWords" />
                                    </ToolTip>
                                </ToolTipService.ToolTip>
                                <controls:SettingsCard.Header>
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Uid="PullRebaseHeaderTextBlock" />
                                        <TextBlock
                                            x:Uid="PullRebaseDescriptionTextBlock"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </controls:SettingsCard.Header>
                                <ComboBox
                                    x:Name="GlobalPullRebaseComboBox"
                                    x:Uid="PullRebaseComboBox"
                                    Width="180"
                                    AutomationProperties.AutomationId="GlobalPullRebase"
                                    DisplayMemberPath="DisplayName"
                                    ItemsSource="{x:Bind ViewModel.GlobalPullRebaseOptions}"
                                    SelectedItem="{x:Bind ViewModel.SelectedGlobalPullRebase, Mode=TwoWay}" />
                            </controls:SettingsCard>

                            <controls:SettingsCard IsEnabled="{x:Bind ViewModel.IsGlobalPullSettingsLoaded, Mode=OneWay}">
                                <ToolTipService.ToolTip>
                                    <ToolTip MaxWidth="480">
                                        <TextBlock
                                            x:Uid="PullFastForwardDetailsTextBlock"
                                            TextWrapping="WrapWholeWords" />
                                    </ToolTip>
                                </ToolTipService.ToolTip>
                                <controls:SettingsCard.Header>
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Uid="PullFastForwardHeaderTextBlock" />
                                        <TextBlock
                                            x:Uid="PullFastForwardDescriptionTextBlock"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </controls:SettingsCard.Header>
                                <ComboBox
                                    x:Name="GlobalPullFastForwardComboBox"
                                    x:Uid="PullFastForwardComboBox"
                                    Width="180"
                                    AutomationProperties.AutomationId="GlobalPullFastForward"
                                    DisplayMemberPath="DisplayName"
                                    ItemsSource="{x:Bind ViewModel.GlobalPullFastForwardOptions}"
                                    SelectedItem="{x:Bind ViewModel.SelectedGlobalPullFastForward, Mode=TwoWay}" />
                            </controls:SettingsCard>


                            <controls:SettingsCard>
                                <controls:SettingsCard.Header>
                                    <StackPanel>
                                        <TextBlock x:Uid="RepositoryUserNameSettingsCardHeaderTextBlock" />
                                        <TextBlock x:Uid="RepositoryUserNameSettingsCardHeaderDescriptionTextBlock"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </controls:SettingsCard.Header>
                                <TextBox
                                    x:Name="GlobalUserNameTextBox"
                                    x:Uid="RepositoryUserNameSettingsTextBox"
                                    MinWidth="260"
                                    Text="{x:Bind ViewModel.GlobalRepositoryUserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </controls:SettingsCard>

                            <controls:SettingsCard>
                                <controls:SettingsCard.Header>
                                    <StackPanel>
                                        <TextBlock x:Uid="RepositoryEmailSettingsCardHeaderTextBlock" />
                                        <TextBlock x:Uid="RepositoryEmailSettingsCardHeaderDescriptionTextBlock"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </controls:SettingsCard.Header>
                                <TextBox
                                    x:Name="GlobalEmailTextBox"
                                    x:Uid="RepositoryEmailSettingsTextBox"
                                    MinWidth="260"
                                    Text="{x:Bind ViewModel.GlobalRepositoryEmail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </controls:SettingsCard>

                            <controls:SettingsCard>
                                <controls:SettingsCard.Header>
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Uid="CredentialHelperSettingsCardHeaderTextBlock" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind ViewModel.CredentialHelperStatus, Mode=OneWay}"
                                            TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </controls:SettingsCard.Header>
                                <ToggleSwitch
                                    x:Uid="CredentialHelperToggleSwitch"
                                    IsOn="{x:Bind ViewModel.UseCredentialHelperManager, Mode=TwoWay}" />
                            </controls:SettingsCard>

                            <controls:SettingsCard>
                                <controls:SettingsCard.Header>
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Uid="SshCommandSettingsCardHeaderTextBlock" />
                                        <TextBlock
                                            x:Uid="SshCommandSettingsCardHeaderDescriptionTextBlock"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </controls:SettingsCard.Header>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBox
                                        x:Name="SshCommandTextBox"
                                        x:Uid="SshCommandTextBox"
                                        Width="320"
                                        AutomationProperties.AutomationId="SshCommandPath"
                                        Text="{x:Bind ViewModel.SshCommand, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <ToggleSwitch
                                        x:Uid="SshCommandToggleSwitch"
                                        VerticalAlignment="Center"
                                        IsOn="{x:Bind ViewModel.UseSshCommandOverride, Mode=TwoWay}" />
                                </StackPanel>
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>

                    <controls:SettingsExpander
                        x:Name="GlobalUrlRewritesExpander"
                        IsExpanded="False"
                        ItemsSource="{x:Bind ViewModel.GlobalUrlRewrites, Mode=OneWay}">
                        <controls:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE71B;" />
                        </controls:SettingsExpander.HeaderIcon>
                        <controls:SettingsExpander.Header>
                            <StackPanel Spacing="4">
                                <TextBlock x:Uid="GlobalUrlRewritesTitleTextBlock" />
                                <TextBlock
                                    x:Uid="GlobalUrlRewritesDescriptionTextBlock"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </controls:SettingsExpander.Header>
                        <Button
                            x:Uid="AddGlobalUrlRewriteButton"
                            AutomationProperties.AutomationId="AddGlobalUrlRewriteButton"
                            Command="{x:Bind ViewModel.AddGlobalUrlRewriteCommand, Mode=OneWay}" />
                        <controls:SettingsExpander.ItemTemplate>
                            <DataTemplate x:DataType="models:GitUrlRewrite">
                                <controls:SettingsCard>
                                    <controls:SettingsCard.Header>
                                        <StackPanel Spacing="3">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="{x:Bind InsteadOfUrl, Mode=OneTime}"
                                                TextWrapping="WrapWholeWords" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind ReplacementUrl, Mode=OneTime}"
                                                TextWrapping="WrapWholeWords" />
                                        </StackPanel>
                                    </controls:SettingsCard.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button
                                            x:Uid="EditGlobalUrlRewriteButton"
                                            AutomationProperties.AutomationId="EditGlobalUrlRewriteButton"
                                            Command="{Binding DataContext.EditGlobalUrlRewriteCommand, ElementName=GlobalUrlRewritesExpander}"
                                            CommandParameter="{x:Bind}" />
                                        <Button
                                            x:Uid="RemoveGlobalUrlRewriteButton"
                                            AutomationProperties.AutomationId="RemoveGlobalUrlRewriteButton"
                                            Command="{Binding DataContext.RemoveGlobalUrlRewriteCommand, ElementName=GlobalUrlRewritesExpander}"
                                            CommandParameter="{x:Bind}" />
                                    </StackPanel>
                                </controls:SettingsCard>
                            </DataTemplate>
                        </controls:SettingsExpander.ItemTemplate>
                    </controls:SettingsExpander>

                    <controls:SettingsExpander IsExpanded="False">
                        <controls:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE77B;" />
                        </controls:SettingsExpander.HeaderIcon>
                        <controls:SettingsExpander.Header>
                            <StackPanel>
                                <TextBlock x:Uid="RepositorySettingsTitleTextBlock" />
                                <TextBlock x:Uid="RepositorySettingsTitleDescriptionTextBlock"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </controls:SettingsExpander.Header>
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard>
                                <controls:SettingsCard.Header>
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Uid="RepositoryPushDefaultRemoteSettingsCardHeaderTextBlock" />
                                        <TextBlock
                                            x:Uid="RepositoryPushDefaultRemoteSettingsCardHeaderDescriptionTextBlock"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </controls:SettingsCard.Header>
                                <TextBox
                                    x:Name="RepositoryPushDefaultRemoteTextBox"
                                    x:Uid="RepositoryPushDefaultRemoteSettingsTextBox"
                                    MinWidth="260"
                                    AutomationProperties.AutomationId="RepositoryPushDefaultRemote"
                                    Text="{x:Bind ViewModel.RepositoryPushDefaultRemote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </controls:SettingsCard>

                            <controls:SettingsCard IsEnabled="{x:Bind ViewModel.IsRepositoryPullSettingsLoaded, Mode=OneWay}">
                                <ToolTipService.ToolTip>
                                    <ToolTip MaxWidth="480">
                                        <TextBlock
                                            x:Uid="PullRebaseDetailsTextBlock"
                                            TextWrapping="WrapWholeWords" />
                                    </ToolTip>
                                </ToolTipService.ToolTip>
                                <controls:SettingsCard.Header>
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Uid="PullRebaseHeaderTextBlock" />
                                        <TextBlock
                                            x:Uid="PullRebaseDescriptionTextBlock"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </controls:SettingsCard.Header>
                                <ComboBox
                                    x:Name="RepositoryPullRebaseComboBox"
                                    x:Uid="PullRebaseComboBox"
                                    Width="180"
                                    AutomationProperties.AutomationId="RepositoryPullRebase"
                                    DisplayMemberPath="DisplayName"
                                    ItemsSource="{x:Bind ViewModel.RepositoryPullRebaseOptions}"
                                    SelectedItem="{x:Bind ViewModel.SelectedRepositoryPullRebase, Mode=TwoWay}" />
                            </controls:SettingsCard>

                            <controls:SettingsCard IsEnabled="{x:Bind ViewModel.IsRepositoryPullSettingsLoaded, Mode=OneWay}">
                                <ToolTipService.ToolTip>
                                    <ToolTip MaxWidth="480">
                                        <TextBlock
                                            x:Uid="PullFastForwardDetailsTextBlock"
                                            TextWrapping="WrapWholeWords" />
                                    </ToolTip>
                                </ToolTipService.ToolTip>
                                <controls:SettingsCard.Header>
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Uid="PullFastForwardHeaderTextBlock" />
                                        <TextBlock
                                            x:Uid="PullFastForwardDescriptionTextBlock"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </controls:SettingsCard.Header>
                                <ComboBox
                                    x:Name="RepositoryPullFastForwardComboBox"
                                    x:Uid="PullFastForwardComboBox"
                                    Width="180"
                                    AutomationProperties.AutomationId="RepositoryPullFastForward"
                                    DisplayMemberPath="DisplayName"
                                    ItemsSource="{x:Bind ViewModel.RepositoryPullFastForwardOptions}"
                                    SelectedItem="{x:Bind ViewModel.SelectedRepositoryPullFastForward, Mode=TwoWay}" />
                            </controls:SettingsCard>


                            <controls:SettingsCard>
                                <controls:SettingsCard.Header>
                                    <StackPanel>
                                        <TextBlock x:Uid="RepositoryUserNameSettingsCardHeaderTextBlock" />
                                        <TextBlock x:Uid="RepositoryUserNameSettingsCardHeaderDescriptionTextBlock"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </controls:SettingsCard.Header>
                                <TextBox
                                    x:Name="RepositoryUserNameTextBox"
                                    x:Uid="RepositoryUserNameSettingsTextBox"
                                    MinWidth="260"
                                    Text="{x:Bind ViewModel.RepositoryUserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </controls:SettingsCard>

                            <controls:SettingsCard>
                                <controls:SettingsCard.Header>
                                    <StackPanel>
                                        <TextBlock x:Uid="RepositoryEmailSettingsCardHeaderTextBlock" />
                                        <TextBlock x:Uid="RepositoryEmailSettingsCardHeaderDescriptionTextBlock"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </controls:SettingsCard.Header>
                                <TextBox
                                    x:Name="RepositoryEmailTextBox"
                                    x:Uid="RepositoryEmailSettingsTextBox"
                                    MinWidth="260"
                                    Text="{x:Bind ViewModel.RepositoryEmail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>

                    <controls:SettingsCard>
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE74E;" />
                        </controls:SettingsCard.HeaderIcon>
                        <controls:SettingsCard.Header>
                            <TextBlock x:Uid="SaveGitSettingsCardHeaderTextBlock" />
                        </controls:SettingsCard.Header>
                        <Grid
                            ColumnDefinitions="Auto,Auto"
                            ColumnSpacing="12"
                            RowDefinitions="Auto,Auto">
                            <TextBlock
                                x:Name="RepositorySettingsStatus"
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.RepositorySettingsStatus, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <Button
                                Grid.Column="1"
                                x:Name="SaveRepositorySettingsButton"
                                x:Uid="SaveRepositorySettingsButton"
                                Command="{x:Bind ViewModel.SaveRepositorySettingsCommand, Mode=OneWay}" />
                        </Grid>
                    </controls:SettingsCard>
                </StackPanel>
            </StackPanel>
            </Grid>
        </ScrollViewer>

    </Grid>
</Page>
