<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SimpleGit11.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SimpleGit11.Controls"
    xmlns:models="using:SimpleGit11.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="SimpleGit11">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid
        x:Name="RootLayout"
        DataContext="{x:Bind ViewModel, Mode=OneWay}">
        <NavigationView
            x:Name="ShellNavigation"
            AlwaysShowHeader="False"
            BackRequested="ShellNavigation_BackRequested"
            KeyboardAcceleratorPlacementMode="Hidden"
            IsBackButtonVisible="Auto"
            IsBackEnabled="False"
            IsPaneOpen="True"
            IsPaneToggleButtonVisible="True"
            IsSettingsVisible="True"
            ItemInvoked="ShellNavigation_ItemInvoked"
            Margin="0,32,0,0"
            OpenPaneLength="300"
            PaneDisplayMode="Auto"
            SelectionChanged="ShellNavigation_SelectionChanged">
            <NavigationView.KeyboardAccelerators>
                <KeyboardAccelerator
                    Key="Left"
                    Modifiers="Menu"
                    Invoked="BackKeyboardAccelerator_Invoked" />
            </NavigationView.KeyboardAccelerators>
            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Uid="RepositoryNavigationItem"
                    Icon="Home"
                    IsSelected="True"
                    Tag="Repository" />
                <NavigationViewItem
                    x:Uid="ChangesNavigationItem"
                    Icon="Edit"
                    Tag="Changes" />
                <NavigationViewItem
                    x:Uid="HistoryNavigationItem"
                    Icon="Clock"
                    Tag="History" />
                <NavigationViewItem
                    x:Uid="BranchesNavigationItem"
                    Tag="Branches">
                    <NavigationViewItem.Icon>
                        <controls:BranchIcon />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Uid="SynchronizationNavigationItem"
                    Icon="Globe"
                    Tag="Synchronization" />
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem
                    x:Name="AboutNavigationItem"
                    x:Uid="AboutNavigationItem"
                    AutomationProperties.AutomationId="AboutNavigationItem"
                    SelectsOnInvoked="False"
                    Tag="About">
                    <NavigationViewItem.Icon>
                        <FontIcon
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <NavigationView.PaneHeader>
                <Grid Padding="10,30,10,30">
                    <Grid.Resources>
                        <Style x:Key="PaneHeaderButtonStyle" TargetType="controls:HandCursorButton">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="MinWidth" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="UseSystemFocusVisuals" Value="True" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="controls:HandCursorButton">
                                        <ContentPresenter
                                            x:Name="ContentPresenter"
                                            Background="Transparent"
                                            Content="{TemplateBinding Content}"
                                            ContentTemplate="{TemplateBinding ContentTemplate}"
                                            ContentTransitions="{TemplateBinding ContentTransitions}"
                                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            Padding="{TemplateBinding Padding}"
                                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
                                            <VisualStateManager.VisualStateGroups>
                                                <VisualStateGroup x:Name="CommonStates">
                                                    <VisualState x:Name="Normal" />
                                                    <VisualState x:Name="PointerOver" />
                                                    <VisualState x:Name="Pressed">
                                                        <VisualState.Setters>
                                                            <Setter Target="ContentPresenter.Opacity" Value="0.7" />
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                    <VisualState x:Name="Disabled">
                                                        <VisualState.Setters>
                                                            <Setter Target="ContentPresenter.Opacity" Value="0.4" />
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                </VisualStateGroup>
                                            </VisualStateManager.VisualStateGroups>
                                        </ContentPresenter>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Grid.Resources>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock
                            Style="{ThemeResource TitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.AppName, Mode=OneTime}" />
                        <controls:HandCursorButton
                            x:Name="RepositoryPaneHeaderButton"
                            x:Uid="RepositoryPaneHeaderButton"
                            HorizontalContentAlignment="Stretch"
                            Padding="0"
                            Style="{StaticResource PaneHeaderButtonStyle}"
                            Click="RepositoryPaneHeaderButton_Click">
                            <controls:HandCursorButton.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem
                                        x:Uid="PaneHeaderOpenRepositoryMenuFlyoutItem"
                                        Command="{x:Bind RepositoryViewModel.OpenRepositoryCommand, Mode=OneWay}"
                                        Icon="OpenFile" />
                                    <MenuFlyoutItem
                                        x:Uid="PaneHeaderCloseRepositoryMenuFlyoutItem"
                                        Command="{x:Bind RepositoryViewModel.CloseRepositoryCommand, Mode=OneWay}"
                                        Icon="Cancel" />
                                </MenuFlyout>
                            </controls:HandCursorButton.ContextFlyout>
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="&#xE8B7;"
                                    IsHitTestVisible="False"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    Grid.Column="1"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.CurrentRepositoryDisplayName, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </controls:HandCursorButton>
                        <controls:HandCursorButton
                            x:Name="RemotePaneHeaderButton"
                            x:Uid="RemotePaneHeaderButton"
                            HorizontalContentAlignment="Stretch"
                            Padding="0"
                            Style="{StaticResource PaneHeaderButtonStyle}"
                            Click="RemotePaneHeaderButton_Click">
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="&#xE774;"
                                    IsHitTestVisible="False"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    Grid.Column="1"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.SelectedRemoteName, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </controls:HandCursorButton>
                        <controls:HandCursorButton
                            x:Name="BranchPaneHeaderButton"
                            x:Uid="BranchPaneHeaderButton"
                            HorizontalContentAlignment="Stretch"
                            Padding="0"
                            Style="{StaticResource PaneHeaderButtonStyle}"
                            Click="BranchPaneHeaderButton_Click">
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <controls:BranchIcon
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    IsHitTestVisible="False"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    Grid.Column="1"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.CurrentBranch, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </controls:HandCursorButton>
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE77B;"
                                IsHitTestVisible="False"
                                VerticalAlignment="Center" />
                            <Grid Grid.Column="1">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.CurrentUserName, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    Visibility="{x:Bind ViewModel.LocalOrUnsetUserNameVisibility, Mode=OneWay}" />
                                <TextBlock
                                    x:Uid="GlobalGitUserWarningTextBlock"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.CurrentUserName, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    Visibility="{x:Bind ViewModel.GlobalUserNameVisibility, Mode=OneWay}" />
                            </Grid>
                        </Grid>
                    </StackPanel>
                    <Image Grid.Column="1"
                           Source="/Assets/MainLogo.png"
                           Width="70"
                           Height="70"
                           VerticalAlignment="Top"/>
                </Grid>
            </NavigationView.PaneHeader>

            <NavigationView.PaneFooter>
                <StackPanel
                    x:Name="PaneFooterContent"
                    Padding="12,8,12,16"
                    Spacing="8">
                    <TextBlock
                        x:Uid="RecentRepositoriesTextBlock"
                        Margin="4,0"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}" />
                    <ListView
                        x:Name="RecentRepositoriesList"
                        Height="{x:Bind RecentRepositoriesList.MaxHeight, Mode=OneWay}"
                        ItemsSource="{x:Bind ViewModel.RecentRepositories, Mode=OneWay}"
                        MaxHeight="168"
                        SelectedItem="{x:Bind ViewModel.SelectedRecentRepository, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Margin" Value="0,0,0,6" />
                                <Setter Property="Padding" Value="12,6,8,6" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Grid
                                                MinHeight="48"
                                                Margin="{TemplateBinding Margin}">
                                                <VisualStateManager.VisualStateGroups>
                                                    <VisualStateGroup x:Name="CommonStates">
                                                        <VisualState x:Name="Normal" />
                                                        <VisualState x:Name="PointerOver">
                                                            <VisualState.Setters>
                                                                <Setter Target="SelectionBackground.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                        <VisualState x:Name="Pressed">
                                                            <VisualState.Setters>
                                                                <Setter Target="SelectionBackground.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                    </VisualStateGroup>
                                                    <VisualStateGroup x:Name="SelectionStates">
                                                        <VisualState x:Name="Unselected" />
                                                        <VisualState x:Name="Selected">
                                                            <VisualState.Setters>
                                                                <Setter Target="SelectionBackground.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                                                <Setter Target="SelectionIndicator.Opacity" Value="1" />
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                        <VisualState x:Name="SelectedPointerOver">
                                                            <VisualState.Setters>
                                                                <Setter Target="SelectionBackground.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                                                <Setter Target="SelectionIndicator.Opacity" Value="1" />
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                        <VisualState x:Name="SelectedPressed">
                                                            <VisualState.Setters>
                                                                <Setter Target="SelectionBackground.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                                                <Setter Target="SelectionIndicator.Opacity" Value="1" />
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                    </VisualStateGroup>
                                                </VisualStateManager.VisualStateGroups>

                                                <Border
                                                    x:Name="SelectionBackground"
                                                    Background="Transparent"
                                                    CornerRadius="{ThemeResource ControlCornerRadius}">
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="4" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <Rectangle
                                                            x:Name="SelectionIndicator"
                                                            Width="3"
                                                            Height="18"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                                            Opacity="0"
                                                            RadiusX="1.5"
                                                            RadiusY="1.5" />

                                                        <ContentPresenter
                                                            Grid.Column="1"
                                                            Margin="{TemplateBinding Padding}"
                                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                            Content="{TemplateBinding Content}"
                                                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:RepositoryInfo">
                                <StackPanel
                                    MaxHeight="44"
                                    Spacing="2"
                                    ToolTipService.ToolTip="{x:Bind Path, Mode=OneTime}">
                                    <StackPanel.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem
                                                x:Uid="RemoveRecentRepositoryMenuFlyoutItem"
                                                Command="{Binding DataContext.RemoveRecentRepositoryCommand, ElementName=RecentRepositoriesList}"
                                                CommandParameter="{x:Bind}"
                                                Icon="Remove" />
                                        </MenuFlyout>
                                    </StackPanel.ContextFlyout>
                                    <TextBlock
                                        MaxLines="1"
                                        Text="{x:Bind Name, Mode=OneTime}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        MaxLines="1"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Path, Mode=OneTime}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </NavigationView.PaneFooter>

            <Grid>
                <Frame
                    x:Name="ContentFrame"
                    Navigated="ContentFrame_Navigated" />

                <controls:OperationProgressOverlay
                    Margin="24"
                    Canvas.ZIndex="10"
                    VerticalAlignment="Bottom"
                    CancelButtonVisibility="{x:Bind ViewModel.OperationCancelButtonVisibility, Mode=OneWay}"
                    CancelCommand="{x:Bind ViewModel.OperationCancelCommand, Mode=OneWay}"
                    IsRunning="{x:Bind ViewModel.IsOperationRunning, Mode=OneWay}"
                    Message="{x:Bind ViewModel.ProgressMessage, Mode=OneWay}" />

                <controls:NotificationOverlay
                    Margin="24"
                    Canvas.ZIndex="20"
                    VerticalAlignment="Top"
                    ActionCommand="{x:Bind ViewModel.NotificationActionCommand, Mode=OneWay}"
                    ActionContent="{x:Bind ViewModel.NotificationActionText, Mode=OneWay}"
                    ActionVisibility="{x:Bind ViewModel.NotificationActionVisibility, Mode=OneWay}"
                    CopyCommand="{x:Bind ViewModel.CopyNotificationTextCommand, Mode=OneWay}"
                    Details="{x:Bind ViewModel.NotificationDetails, Mode=OneWay}"
                    IsOpen="{x:Bind ViewModel.IsNotificationOpen, Mode=TwoWay}"
                    Message="{x:Bind ViewModel.NotificationMessage, Mode=OneWay}"
                    Severity="{x:Bind ViewModel.NotificationSeverity, Mode=OneWay}" />
            </Grid>
        </NavigationView>

        <Grid
            x:Name="AppTitleBar"
            Height="32"
            Margin="0,0,138,0"
            VerticalAlignment="Top"
            Background="Transparent" />
    </Grid>
</Window>
