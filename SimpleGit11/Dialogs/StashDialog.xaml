<?xml version="1.0" encoding="utf-8"?>
<Flyout
    x:Class="SimpleGit11.Dialogs.StashDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Placement="BottomEdgeAlignedRight"
    ShowMode="Transient">

    <Flyout.FlyoutPresenterStyle>
        <Style TargetType="FlyoutPresenter" BasedOn="{StaticResource DefaultFlyoutPresenterStyle}">
            <Setter Property="MaxWidth" Value="690"/>
        </Style>
    </Flyout.FlyoutPresenterStyle>
    
    <StackPanel
        x:Name="RootGrid"
        Padding="20"
        Spacing="16">

        <StackPanel Orientation="Horizontal" 
                    Spacing="20">
            <StackPanel Spacing="4" VerticalAlignment="Center">
                <TextBlock
                    x:Uid="StashDialogTitleTextBlock"
                    Style="{ThemeResource SubtitleTextBlockStyle}" />
                <TextBlock
                    x:Uid="StashListDescriptionTextBlock"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <CommandBar DefaultLabelPosition="Right" VerticalAlignment="Center">
                <AppBarButton
                    x:Uid="CreateStashAppBarButton"
                    Command="{Binding CreateStashCommand}"
                    Icon="Download" />
                <AppBarButton
                    x:Uid="ApplyStashAppBarButton"
                    Command="{Binding ApplyStashCommand}"
                    Icon="Forward" />
                <AppBarButton
                    x:Uid="PopStashAppBarButton"
                    Command="{Binding PopStashCommand}"
                    Icon="Upload" />
                <AppBarElementContainer>
                    <SplitButton
                        x:Uid="DropStashSplitButton"
                        Command="{Binding DropStashCommand}"
                        Style="{StaticResource SplitButtonCommandBarStyle}">
                        <SplitButton.Content>
                            <StackPanel Orientation="Horizontal">
                                <SymbolIcon Symbol="Clear" />
                                <TextBlock
                                    x:Uid="DropStashSplitButtonTextBlock"
                                    Margin="8,0,0,0" />
                            </StackPanel>
                        </SplitButton.Content>
                        <SplitButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem
                                    x:Uid="DropAllStashesMenuFlyoutItem"
                                    Command="{Binding DropAllStashesCommand}"
                                    Icon="Delete" />
                            </MenuFlyout>
                        </SplitButton.Flyout>
                    </SplitButton>
                </AppBarElementContainer>
            </CommandBar>
            
        </StackPanel>
        
        <ListView
            Grid.Row="1"
            ItemsSource="{Binding Stashes}"
            DisplayMemberPath="DisplayName"
            SelectedItem="{Binding SelectedStash, Mode=TwoWay}"
            SelectionMode="Single" />

    </StackPanel>
</Flyout>
