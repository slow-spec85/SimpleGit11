<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="SimpleGit11.Dialogs.ArchiveDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:SimpleGit11.Models"
    x:Uid="ArchiveDialog"
    DataContext="{x:Bind ViewModel, Mode=OneWay}"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanArchive, Mode=OneWay}"
    PrimaryButtonClick="ArchiveDialog_PrimaryButtonClick"
    Style="{StaticResource DefaultContentDialogStyle}">

    <StackPanel MinWidth="480" Spacing="12">
        <TextBlock
            x:Uid="ArchiveDialogDescriptionTextBlock"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="WrapWholeWords" />

        <ComboBox
            x:Name="SourceComboBox"
            x:Uid="ArchiveSourceComboBox"
            HorizontalAlignment="Stretch"
            DisplayMemberPath="DisplayName"
            ItemsSource="{x:Bind ViewModel.RevisionSelector.SourceOptions, Mode=OneWay}"
            SelectedItem="{x:Bind ViewModel.RevisionSelector.SelectedSourceOption, Mode=TwoWay}"
            SelectionChanged="SourceComboBox_SelectionChanged" />

        <AutoSuggestBox
            x:Name="StartPointAutoSuggestBox"
            x:Uid="ArchiveStartPointAutoSuggestBox"
            HorizontalAlignment="Stretch"
            IsEnabled="{x:Bind ViewModel.RevisionSelector.IsStartPointEnabled, Mode=OneWay}"
            ItemsSource="{x:Bind ViewModel.RevisionSelector.FilteredSuggestions, Mode=OneWay}"
            SuggestionChosen="StartPointAutoSuggestBox_SuggestionChosen"
            Text="{x:Bind ViewModel.RevisionSelector.StartPoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            TextMemberPath="Value"
            TextChanged="StartPointAutoSuggestBox_TextChanged">
            <AutoSuggestBox.ItemTemplate>
                <DataTemplate x:DataType="models:GitRevisionSuggestion">
                    <StackPanel Spacing="2">
                        <TextBlock
                            FontWeight="SemiBold"
                            MaxLines="1"
                            Text="{x:Bind DisplayName, Mode=OneTime}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            MaxLines="1"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind Description, Mode=OneTime}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </AutoSuggestBox.ItemTemplate>
        </AutoSuggestBox>

        <TextBlock
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{ThemeResource CaptionTextBlockStyle}"
            Text="{x:Bind ViewModel.RevisionSelector.Description, Mode=OneWay}"
            TextWrapping="WrapWholeWords" />

        <StackPanel
            Orientation="Horizontal"
            Spacing="8"
            Visibility="{x:Bind ViewModel.RevisionSelector.IsLoading, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
            <ProgressRing
                Width="16"
                Height="16"
                IsActive="{x:Bind ViewModel.RevisionSelector.IsLoading, Mode=OneWay}" />
            <TextBlock
                x:Uid="ArchiveLoadingStartPointsTextBlock"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}" />
        </StackPanel>

        <InfoBar
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.RevisionSelector.HasStatusMessage, Mode=OneWay}"
            Message="{x:Bind ViewModel.RevisionSelector.StatusMessage, Mode=OneWay}"
            Severity="Error" />

        <ComboBox
            x:Uid="ArchiveFormatComboBox"
            HorizontalAlignment="Stretch"
            DisplayMemberPath="DisplayName"
            ItemsSource="{x:Bind ViewModel.FormatOptions, Mode=OneWay}"
            SelectedItem="{x:Bind ViewModel.SelectedFormatOption, Mode=TwoWay}" />

        <CheckBox
            x:Uid="ArchiveIncludeRootDirectoryCheckBox"
            IsChecked="{x:Bind ViewModel.IncludeRootDirectory, Mode=TwoWay}" />
    </StackPanel>
</ContentDialog>
