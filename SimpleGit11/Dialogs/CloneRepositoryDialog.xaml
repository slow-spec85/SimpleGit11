<?xml version="1.0" encoding="utf-8"?>
<Flyout
    x:Class="SimpleGit11.Dialogs.CloneRepositoryDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Placement="BottomEdgeAlignedRight"
    ShowMode="Standard">

    <Flyout.FlyoutPresenterStyle>
        <Style
            BasedOn="{StaticResource DefaultFlyoutPresenterStyle}"
            TargetType="FlyoutPresenter">
            <Setter Property="MaxWidth" Value="480" />
        </Style>
    </Flyout.FlyoutPresenterStyle>

    <StackPanel
        x:Name="RootPanel"
        Width="420"
        Padding="20"
        Spacing="12">
        <TextBox
            x:Name="CloneRepositoryUrlInput"
            x:Uid="CloneRepositoryUrlTextBox"
            Text="{Binding CloneRepositoryUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <CheckBox
            x:Uid="CloneSubmodulesRecursivelyCheckBox"
            IsChecked="{Binding CloneSubmodulesRecursively, Mode=TwoWay}" />
        <Button
            x:Uid="CloneRepositoryFlyoutButton"
            HorizontalAlignment="Right"
            Command="{Binding CloneRepositoryCommand}" />
    </StackPanel>
</Flyout>
