<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="SimpleGit11.Dialogs.CommitDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:SimpleGit11.Models"
    CloseButtonText="{x:Bind ViewModel.CloseButtonText, Mode=OneTime}"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanCommit, Mode=OneWay}"
    PrimaryButtonText="{x:Bind ViewModel.PrimaryButtonText, Mode=OneTime}"
    Style="{StaticResource DefaultContentDialogStyle}"
    Title="{x:Bind ViewModel.Title, Mode=OneTime}">
    <ContentDialog.Resources>
        <Flyout
            x:Name="FileSuggestionsFlyout"
            Placement="Bottom"
            ShouldConstrainToRootBounds="True">
            <ListView
                x:Name="CommitFileSuggestionsListView"
                x:Uid="CommitFileSuggestionsListView"
                Width="420"
                MaxHeight="216"
                IsItemClickEnabled="True"
                IsTabStop="False"
                ItemClick="CommitFileSuggestionsListView_ItemClick"
                ItemsSource="{x:Bind ViewModel.FileSuggestions, Mode=OneWay}"
                KeyDown="FileSuggestions_KeyDown"
                SelectionMode="Single">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="MinHeight" Value="36" />
                        <Setter Property="Padding" Value="8,3" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:GitChangedFile">
                        <Grid MinWidth="360">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="18" />
                                <RowDefinition Height="14" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                MaxLines="1"
                                Text="{x:Bind FileName, Mode=OneTime}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Row="1"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                MaxLines="1"
                                Text="{x:Bind Path, Mode=OneTime}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Flyout>
    </ContentDialog.Resources>

    <StackPanel Spacing="8">
        <InfoBar
                x:Uid="NoLocalCommitsInfoBar"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.NoLocalCommits, Mode=OneWay}"
                Severity="Informational" />
        
        <CheckBox
            x:Uid="AmendMessageCheckBox"
            IsChecked="{x:Bind ViewModel.EditMessage, Mode=TwoWay}"
            Visibility="{x:Bind ViewModel.IsAmend, Mode=OneWay}" />

        <TextBox
            x:Name="CommitMessageTextBox"
            AcceptsReturn="True"
            AutomationProperties.HelpText="{x:Bind ViewModel.MessageHelpText, Mode=OneTime}"
            Header="{x:Bind ViewModel.MessageHeader, Mode=OneTime}"
            MinHeight="120"
            MinWidth="420"
            MaxHeight="200"
            MaxWidth="600"
            PlaceholderText="{x:Bind ViewModel.MessagePlaceholder, Mode=OneTime}"
            PreviewKeyDown="CommitMessageTextBox_PreviewKeyDown"
            SelectionChanged="CommitMessageTextBox_SelectionChanged"
            Text="{x:Bind ViewModel.Message, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            TextChanged="CommitMessageTextBox_TextChanged"
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.EditMessage, Mode=OneWay}" />
    </StackPanel>
</ContentDialog>
