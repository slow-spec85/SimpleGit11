<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="SimpleGit11.Dialogs.GitUrlRewriteDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Uid="GitUrlRewriteDialog"
    DataContext="{x:Bind ViewModel, Mode=OneWay}"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}"
    Style="{StaticResource DefaultContentDialogStyle}">

    <StackPanel MinWidth="440" Spacing="12">
        <TextBlock
            x:Uid="GitUrlRewriteDialogDescriptionTextBlock"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="WrapWholeWords" />
        <TextBox
            x:Uid="GitUrlRewriteInsteadOfTextBox"
            AutomationProperties.AutomationId="GitUrlRewriteInsteadOfInput"
            Text="{x:Bind ViewModel.InsteadOfUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TextBox
            x:Uid="GitUrlRewriteReplacementTextBox"
            AutomationProperties.AutomationId="GitUrlRewriteReplacementInput"
            Text="{x:Bind ViewModel.ReplacementUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
    </StackPanel>
</ContentDialog>
