<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="SimpleGit11.Dialogs.BranchCreateDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:SimpleGit11.Models"
    xmlns:viewmodels="using:SimpleGit11.ViewModels"
    x:Uid="BranchCreateDialog"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanCreate, Mode=OneWay}"
    PrimaryButtonClick="BranchCreateDialog_PrimaryButtonClick"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ScrollViewer
        MaxHeight="560"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        IsTabStop="False"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Auto">
        <StackPanel
            MinWidth="460"
            Spacing="12">
            <TextBox
                x:Uid="BranchCreateNameTextBox"
                Text="{x:Bind ViewModel.BranchName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock
                AutomationProperties.LiveSetting="Polite"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.BranchNameError, Mode=OneWay}"
                TextWrapping="WrapWholeWords"
                Visibility="{x:Bind ViewModel.HasBranchNameError, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />

            <CheckBox
                x:Uid="BranchCreateOrphanCheckBox"
                IsChecked="{x:Bind ViewModel.IsOrphan, Mode=TwoWay}" />

            <RadioButtons
                x:Uid="BranchCreateOrphanContentRadioButtons"
                ItemsSource="{x:Bind ViewModel.OrphanContentOptions, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedOrphanContentOption, Mode=TwoWay}"
                Visibility="{x:Bind ViewModel.IsOrphan, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                <RadioButtons.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:OrphanBranchContentOption">
                        <TextBlock
                            Text="{x:Bind DisplayName, Mode=OneTime}"
                            TextWrapping="WrapWholeWords" />
                    </DataTemplate>
                </RadioButtons.ItemTemplate>
            </RadioButtons>

            <StackPanel
                Spacing="12"
                Visibility="{x:Bind ViewModel.IsStartPointEnabled, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                <ComboBox
                    x:Name="SourceComboBox"
                    x:Uid="BranchCreateSourceComboBox"
                    HorizontalAlignment="Stretch"
                    DisplayMemberPath="DisplayName"
                    ItemsSource="{x:Bind ViewModel.RevisionSelector.SourceOptions, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.RevisionSelector.SelectedSourceOption, Mode=TwoWay}"
                    SelectionChanged="SourceComboBox_SelectionChanged" />

                <AutoSuggestBox
                    x:Name="StartPointAutoSuggestBox"
                    x:Uid="BranchCreateStartPointAutoSuggestBox"
                    HorizontalAlignment="Stretch"
                    IsEnabled="{x:Bind ViewModel.CanEditStartPoint, Mode=OneWay}"
                    ItemsSource="{x:Bind ViewModel.RevisionSelector.FilteredSuggestions, Mode=OneWay}"
                    SuggestionChosen="StartPointAutoSuggestBox_SuggestionChosen"
                    Text="{x:Bind ViewModel.RevisionSelector.StartPoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextMemberPath="Value"
                    TextChanged="StartPointAutoSuggestBox_TextChanged">
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate x:DataType="models:GitRevisionSuggestion">
                            <StackPanel Spacing="2">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    MaxLines="1"
                                    Text="{x:Bind DisplayName, Mode=OneTime}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    MaxLines="1"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Description, Mode=OneTime}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.RevisionSelector.Description, Mode=OneWay}"
                    TextWrapping="WrapWholeWords" />
                <TextBlock
                    AutomationProperties.LiveSetting="Polite"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.StartPointError, Mode=OneWay}"
                    TextWrapping="WrapWholeWords"
                    Visibility="{x:Bind ViewModel.HasStartPointError, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.RevisionSelector.IsLoading, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                    <ProgressRing
                        Width="16"
                        Height="16"
                        IsActive="{x:Bind ViewModel.RevisionSelector.IsLoading, Mode=OneWay}" />
                    <TextBlock
                        x:Uid="BranchCreateLoadingRevisionsTextBlock"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}" />
                </StackPanel>

                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.RevisionSelector.HasStatusMessage, Mode=OneWay}"
                    Message="{x:Bind ViewModel.RevisionSelector.StatusMessage, Mode=OneWay}"
                    Severity="Error" />
            </StackPanel>

            <ToggleSwitch
                x:Uid="BranchCreateAndCheckoutToggleSwitch"
                IsOn="{x:Bind ViewModel.CheckoutBranch, Mode=TwoWay}" />

            <InfoBar
                x:Uid="BranchCreateCheckoutOrphanInfoBar"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.WillCheckoutOrphan, Mode=OneWay}"
                Severity="Warning" />

            <InfoBar
                x:Uid="BranchCreateOrphanWithoutCheckoutInfoBar"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.WillCreateOrphanWithoutCheckout, Mode=OneWay}"
                Severity="Informational" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
