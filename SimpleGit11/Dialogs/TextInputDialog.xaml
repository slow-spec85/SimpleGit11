<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="SimpleGit11.Dialogs.TextInputDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{x:Bind ViewModel.Title, Mode=OneTime}"
    DefaultButton="Primary"
    PrimaryButtonText="{x:Bind ViewModel.PrimaryButtonText, Mode=OneTime}"
    CloseButtonText="{x:Bind ViewModel.CloseButtonText, Mode=OneTime}"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanSubmit, Mode=OneWay}"
    Style="{StaticResource DefaultContentDialogStyle}">

    <StackPanel Spacing="8">
        <TextBox
            x:Name="InputTextBox"
            Header="{x:Bind ViewModel.TextBoxHeader, Mode=OneTime}"
            AcceptsReturn="{x:Bind ViewModel.AcceptsReturn, Mode=OneTime}"
            Height="{x:Bind ViewModel.TextBoxHeight, Mode=OneTime}"
            MinWidth="420"
            PlaceholderText="{x:Bind ViewModel.PlaceholderText, Mode=OneTime}"
            ScrollViewer.VerticalScrollBarVisibility="{x:Bind ViewModel.VerticalScrollBarVisibility, Mode=OneTime}"
            TextWrapping="{x:Bind ViewModel.TextWrapping, Mode=OneTime}"
            Text="{x:Bind ViewModel.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock
            AutomationProperties.LiveSetting="Polite"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            Style="{ThemeResource CaptionTextBlockStyle}"
            Text="{x:Bind ViewModel.TextError, Mode=OneWay}"
            TextWrapping="WrapWholeWords"
            Visibility="{x:Bind ViewModel.HasTextError, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
    </StackPanel>
</ContentDialog>
