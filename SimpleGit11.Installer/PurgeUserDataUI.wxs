<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <!-- Stock WixUI has no data-removal option. Reuse its fonts and cancellation dialog. -->
    <UI Id="PurgeUserDataUI">
      <DialogRef Id="CancelDlg" />
      <Dialog Id="PurgeUserDataDlg" Width="370" Height="270" Title="!(loc.PurgeTitle)">
        <Control Id="Title" Type="Text" X="20" Y="20" Width="330" Height="30" Text="{\WixUI_Font_Title}!(loc.PurgeTitle)" />
        <Control Id="Description" Type="Text" X="20" Y="60" Width="330" Height="45" Text="!(loc.PurgeDescription)" />
        <Control Id="Purge" Type="CheckBox" X="20" Y="115" Width="330" Height="35" Property="PURGEUSERDATA" CheckBoxValue="1" Text="!(loc.PurgeCheckbox)" />
        <Control Id="Warning" Type="Text" X="20" Y="155" Width="330" Height="65" Text="!(loc.PurgeWarning)" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Remove" Type="PushButton" X="200" Y="243" Width="90" Height="17" Text="!(loc.RemoveButton)">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="300" Y="243" Width="60" Height="17" Cancel="yes" Default="yes" Text="!(loc.CancelButton)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>
    </UI>
  </Fragment>
</Wix>
